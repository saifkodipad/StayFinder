<!-- footer.ejs -->
<style>
  /* Airbnb-Inspired Modern Footer */
  .airbnb-footer {
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
    color: #ffffff;
    padding: 64px 0 24px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    position: relative;
    overflow: hidden;
  }



  .footer-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px;
  }

  /* Grid Layout - Responsive */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 56px;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
      margin-bottom: 48px;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 36px;
      margin-bottom: 40px;
    }
    
    .footer-container {
      padding: 0 20px;
    }
    
    .airbnb-footer {
      padding: 48px 0 20px;
    }
  }

  /* Section Titles */
  .footer-section h3 {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 24px;
    position: relative;
    padding-bottom: 12px;
  }

  .footer-section h3::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 3px;
    background-color:#FF5A5F;
    border-radius: 2px;
  }

  /* Footer Links */
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer-link {
    color: #b3b3b3;
    text-decoration: none;
    font-size: 15px;
    font-weight: 400;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    line-height: 1.6;
    position: relative;
    padding-left: 0;
    display: inline-block;
  }

  .footer-link:hover {
    color: #FF5A5F;
    transform: translateX(8px);
    text-decoration: none;
  }

  .footer-link::before {
    content: '→';
    position: absolute;
    left: -20px;
    opacity: 0;
    transition: all 0.3s ease;
    color: #FF5A5F;
  }

  .footer-link:hover::before {
    opacity: 1;
    left: -24px;
  }

  /* Logo Section */
  .footer-logo {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .footer-logo-icon {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .footer-logo-icon:hover {
    transform: translateY(-3px);
  }

  .footer-logo-box {
    width: 48px;
    height: 48px;
    background:  #FF5A5F ;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(255, 90, 95, 0.3);
    transition: all 0.3s ease;
  }

  .footer-logo-icon:hover .footer-logo-box {
    transform: rotate(5deg) scale(1.05);
    box-shadow: 0 12px 32px rgba(255, 90, 95, 0.4);
  }

  .footer-logo-box i {
    color: white;
    font-size: 22px;
  }

  .footer-logo-text {
    font-size: 26px;
    font-weight: 800;
    background-color: #FF5A5F;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .footer-tagline {
    font-size: 15px;
    color: #b3b3b3;
    font-weight: 400;
    line-height: 1.6;
    max-width: 280px;
  }

  /* Newsletter Section */
  .newsletter-form {
    margin-top: 24px;
  }

  .newsletter-title {
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 12px;
  }

  .newsletter-input-wrapper {
    position: relative;
    margin-bottom: 12px;
  }

  .newsletter-input {
    width: 100%;
    padding: 14px 16px;
    background: rgba(255, 255, 255, 0.08);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    font-size: 14px;
    color: #ffffff;
    transition: all 0.3s ease;
  }

  .newsletter-input::placeholder {
    color: #999999;
  }

  .newsletter-input:focus {
    outline: none;
    border-color: #FF5A5F;
    background: rgba(255, 255, 255, 0.12);
    box-shadow: 0 0 0 4px rgba(255, 90, 95, 0.1);
  }

  .newsletter-btn {
    width: 100%;
    padding: 14px 20px;
    background-color:#FF5A5F ;
    color: white;
    border: none;
    border-radius: 12px;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 16px rgba(255, 90, 95, 0.3);
  }

  .newsletter-btn:hover {
    background-color: #FF5A5F; 
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(255, 90, 95, 0.4);
  }

  .newsletter-btn:active {
    transform: translateY(0);
  }

  /* Social Links */
  .social-links {
    display: flex;
    gap: 12px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  .social-link {
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.08);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #b3b3b3;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    font-size: 16px;
  }

  .social-link:hover {
    background: linear-gradient(135deg, #FF5A5F 0%, #FF7C7F 100%);
    border-color: transparent;
    color: #ffffff;
    transform: translateY(-4px) rotate(5deg);
    box-shadow: 0 8px 20px rgba(255, 90, 95, 0.4);
  }

  /* Bottom Bar */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }

  @media (max-width: 768px) {
    .footer-bottom {
      flex-direction: column;
      text-align: center;
      gap: 20px;
      padding-top: 28px;
    }
  }

  .copyright {
    font-size: 14px;
    color: #999999;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .copyright i {
    color: #FF5A5F;
  }

  .footer-bottom-links {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 480px) {
    .footer-bottom-links {
      gap: 16px;
    }
  }

  .footer-bottom-link {
    color: #999999;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.3s ease;
    position: relative;
  }

  .footer-bottom-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #FF5A5F 0%, #FF7C7F 100%);
    transition: width 0.3s ease;
  }

  .footer-bottom-link:hover {
    color: #FF5A5F;
  }

  .footer-bottom-link:hover::after {
    width: 100%;
  }

  /* Newsletter Success Message */
  .newsletter-success {
    display: none;
    padding: 12px 16px;
    background: rgba(46, 213, 115, 0.15);
    border: 2px solid rgba(46, 213, 115, 0.3);
    border-radius: 10px;
    color: #2ed573;
    font-size: 14px;
    font-weight: 600;
    margin-top: 12px;
    animation: slideIn 0.4s ease;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .newsletter-success i {
    margin-right: 8px;
  }

  /* Tablet Specific Adjustments */
  @media (min-width: 641px) and (max-width: 1024px) {
    .footer-section h3 {
      font-size: 13px;
    }
    
    .footer-link {
      font-size: 14px;
    }
  }

  /* Mobile Specific Adjustments */
  @media (max-width: 640px) {
    .footer-section {
      text-align: left;
    }
    
    .social-links {
      justify-content: flex-start;
    }
    
    .newsletter-form {
      margin-top: 20px;
    }
  }

  /* Loading State for Newsletter Button */
  .newsletter-btn.loading {
    pointer-events: none;
    opacity: 0.7;
  }

  .newsletter-btn.success {
    background: linear-gradient(135deg, #2ed573 0%, #26de81 100%);
  }

  /* Accessibility */
  .footer-link:focus,
  .social-link:focus,
  .footer-bottom-link:focus,
  .newsletter-input:focus,
  .newsletter-btn:focus {
    outline: 2px solid #FF5A5F;
    outline-offset: 2px;
  }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<footer class="airbnb-footer">
  <div class="footer-container">
    <div class="footer-grid">
      
      <!-- Brand & Newsletter Section -->
      <div class="footer-logo">
        <a href="/" class="footer-logo-icon" aria-label="StayFinder Home">
