<script>
  document.addEventListener('DOMContentLoaded', function() {
    const newsletterBtn = document.getElementById('newsletterBtn');
    const newsletterInput = document.getElementById('newsletterEmail');
    const newsletterSuccess = document.getElementById('newsletterSuccess');
    
    // Newsletter subscription handler
    function handleNewsletterSubscription() {
      const email = newsletterInput.value.trim();
      
      // Simple email validation
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      
      if (!email) {
        // Shake animation for empty input
        newsletterInput.style.animation = 'shake 0.5s';
        setTimeout(() => {
          newsletterInput.style.animation = '';
        }, 500);
        newsletterInput.focus();
        return;
      }
      
      if (!emailRegex.test(email)) {
        // Invalid email format
        newsletterInput.style.borderColor = '#ff4757';
        newsletterInput.focus();
        setTimeout(() => {
          newsletterInput.style.borderColor = '';
        }, 2000);
        return;
      }
      
      // Show loading state
      newsletterBtn.classList.add('loading');
      newsletterBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Subscribing...';
      newsletterBtn.disabled = true;
      
      // Simulate API call
      setTimeout(() => {
        // Show success state
        newsletterBtn.classList.remove('loading');
        newsletterBtn.classList.add('success');
        newsletterBtn.innerHTML = '<i class="fas fa-check"></i> Subscribed!';
        newsletterSuccess.style.display = 'block';
        newsletterInput.value = '';
        newsletterInput.style.borderColor = '#2ed573';
        
        // Reset button after 3 seconds
        setTimeout(() => {
          newsletterBtn.classList.remove('success');
          newsletterBtn.innerHTML = '<i class="fas fa-paper-plane"></i> Subscribe';
          newsletterBtn.disabled = false;
          newsletterSuccess.style.display = 'none';
          newsletterInput.style.borderColor = '';
        }, 3000);
      }, 1500);
    }
    
    // Button click handler
    newsletterBtn.addEventListener('click', handleNewsletterSubscription);
    
    // Enter key handler
    newsletterInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        handleNewsletterSubscription();
      }
    });

    // Add shake animation for validation
    const style = document.createElement('style');
    style.textContent = `
      @keyframes shake {
        0%, 100% { transform: translateX(0); }
        10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
        20%, 40%, 60%, 80% { transform: translateX(5px); }
      }
    `;
    document.head.appendChild(style);

    // Smooth scroll for internal links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });
  });
</script>
