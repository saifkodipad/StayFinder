<script>
  // Add underline on click functionality
  document.addEventListener('DOMContentLoaded', function() {
    const allLinks = document.querySelectorAll('.f-link, .f-email, .f-social-link');
    
    allLinks.forEach(link => {
      // Remove active class from all links when clicking elsewhere
      document.addEventListener('click', function(e) {
        if (!e.target.closest('.f-link') && !e.target.closest('.f-email') && !e.target.closest('.f-social-link')) {
          allLinks.forEach(l => l.classList.remove('active'));
        }
      });
      
      // Add active class on click
      link.addEventListener('click', function(e) {
        // For internal links, keep the underline active
        if (this.href && !this.target) {
          allLinks.forEach(l => l.classList.remove('active'));
          this.classList.add('active');
        }
        // For external links (target="_blank"), don't keep underline
        // The underline will show during hover/click but won't stay
      });
      
      // Accessibility: Add underline on focus
      link.addEventListener('focus', function() {
        this.classList.add('active');
      });
      
      link.addEventListener('blur', function() {
        this.classList.remove('active');
      });
    });
  });
</script>