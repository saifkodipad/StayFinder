<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StayFinder</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .nav-dropdown {
            display: none;
            position: absolute;
            right: 0;
            margin-top: 0.5rem;
            width: 240px;
            background: white;
            border-radius: 0.75rem;
            box-shadow: 0 10px 40px rgba(0,0,0,0.15);
            border: 1px solid #e5e7eb;
            z-index: 1000;
        }
        .nav-dropdown.show {
            display: block;
            animation: fadeIn 0.2s ease-in-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .mobile-menu {
            display: none;
        }
        .mobile-menu.show {
            display: block;
            animation: slideDown 0.3s ease-in-out;
        }
        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .nav-link-hover {
            transition: all 0.2s ease;
        }
        .nav-link-hover:hover {
            transform: translateY(-1px);
        }
    </style>
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <!-- Left: Logo and Desktop Menu -->
                <div class="flex items-center">
                    <!-- Logo -->
                    <a href="/" class="flex items-center space-x-2 group">
                        <div class="w-10 h-10 bg-gradient-to-br from-blue-600 to-purple-600 rounded-xl flex items-center justify-center shadow-lg group-hover:shadow-blue-200 transition-all duration-300">
                            <i class="fas fa-home text-white text-lg"></i>
                        </div>
                        <div>
                            <span class="text-xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">StayFinder</span>
                            <p class="text-xs text-gray-500 -mt-1">Find your perfect stay</p>
                        </div>
                    </a>

                    <!-- Desktop Navigation Links -->
                    <div class="hidden md:flex items-center ml-10 space-x-1">
                        <a href="/" class="px-4 py-2 text-gray-700 hover:text-blue-600 font-medium rounded-lg hover:bg-blue-50 transition-all duration-200 nav-link-hover">
                            <i class="fas fa-home mr-2"></i>Home
                        </a>
                        <a href="/listings" class="px-4 py-2 text-gray-700 hover:text-blue-600 font-medium rounded-lg hover:bg-blue-50 transition-all duration-200 nav-link-hover">
                            <i class="fas fa-search mr-2"></i>Browse Listings
                        </a>
                        
                        <% if(currentUser) { %>
                            <a href="/listings/new" class="px-4 py-2 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-lg hover:from-blue-600 hover:to-blue-700 transition-all duration-200 shadow-md hover:shadow-lg ml-2 nav-link-hover">
                                <i class="fas fa-plus-circle mr-2"></i>Create Listing
                            </a>
                            
                            <% if(currentUser.role === 'admin') { %>
                                <a href="/admin/dashboard" class="px-4 py-2 bg-gradient-to-r from-amber-500 to-amber-600 text-white font-semibold rounded-lg hover:from-amber-600 hover:to-amber-700 transition-all duration-200 shadow-md hover:shadow-lg ml-2 nav-link-hover">
                                    <i class="fas fa-crown mr-2"></i>Admin Dashboard
                                </a>
                            <% } %>
                        <% } %>
                    </div>
                </div>

                <!-- Right: User Menu / Auth Buttons -->
                <div class="flex items-center space-x-4">
                    <% if(!currentUser) { %>
                        <div class="hidden md:flex items-center space-x-3">
                            <a href="/login" class="px-5 py-2 text-gray-700 hover:text-blue-600 font-medium transition-all duration-200 nav-link-hover">
                                <i class="fas fa-sign-in-alt mr-2"></i>Login
                            </a>
                            <a href="/register" class="px-5 py-2 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-lg hover:from-blue-600 hover:to-blue-700 transition-all duration-200 shadow-md hover:shadow-lg nav-link-hover">
                                <i class="fas fa-user-plus mr-2"></i>Register
                            </a>
                        </div>
                    <% } else { %>
                        <div class="hidden md:flex items-center space-x-4">
                            <!-- User Profile Dropdown -->
                            <div class="relative">
                                <button onclick="toggleDropdown()" class="flex items-center space-x-3 bg-gray-50 hover:bg-gray-100 px-4 py-2 rounded-xl transition-all duration-200 nav-link-hover focus:outline-none">
                                    <div class="relative">
                                        <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-500 rounded-full flex items-center justify-center text-white font-semibold">
                                            <% if(currentUser.firstName) { %>
                                                <%= currentUser.firstName.charAt(0).toUpperCase() %>
                                            <% } else { %>
                                                <%= currentUser.username.charAt(0).toUpperCase() %>
                                            <% } %>
                                        </div>
                                        <% if(currentUser.role === 'admin') { %>
                                            <div class="absolute -top-1 -right-1 w-5 h-5 bg-amber-500 rounded-full flex items-center justify-center">
                                                <i class="fas fa-crown text-white text-xs"></i>
                                            </div>
                                        <% } %>
                                    </div>
                                    <div class="text-left">
                                        <p class="font-semibold text-gray-800">
                                            <%= currentUser.firstName || currentUser.username %>
                                        </p>
                                        <p class="text-xs text-gray-500">
                                            <% if(currentUser.role === 'admin') { %>
                                                <span class="text-amber-600 font-medium">Admin</span>
                                            <% } else if(currentUser.role === 'host') { %>
                                                <span class="text-blue-600 font-medium">Host</span>
                                            <% } else { %>
                                                <span class="text-gray-600">User</span>
                                            <% } %>
                                        </p>
                                    </div>
                                    <i class="fas fa-chevron-down text-gray-400 text-sm"></i>
                                </button>

                                <!-- Dropdown Menu -->
                                <div id="userDropdown" class="nav-dropdown">
                                    <div class="p-4 border-b border-gray-100">
                                        <p class="font-semibold text-gray-800">
                                            <%= currentUser.firstName || currentUser.username %>
                                        </p>
                                        <p class="text-sm text-gray-500">
                                            <%= currentUser.email || 'No email' %>
                                        </p>
                                    </div>
                                    
                                    <div class="p-2">
                                        <a href="/users/profile" class="flex items-center px-3 py-2 text-gray-700 hover:bg-blue-50 rounded-lg transition-all duration-150 mb-1">
                                            <i class="fas fa-user-circle text-blue-500 w-5 mr-3"></i>
                                            <span>My Profile</span>
                                        </a>
                                        
                                        <!-- REMOVED: My Listings link -->
                                        <!-- <a href="/users/listings" class="flex items-center px-3 py-2 text-gray-700 hover:bg-blue-50 rounded-lg transition-all duration-150 mb-1">
                                            <i class="fas fa-home text-green-500 w-5 mr-3"></i>
                                            <span>My Listings</span>
                                        </a> -->
                                        
                                        <% if(currentUser.role === 'admin') { %>
                                            <div class="border-t border-gray-100 my-2 pt-2">
                                                <p class="text-xs font-semibold text-gray-400 uppercase px-3 mb-2">Admin</p>
                                                <a href="/admin/dashboard" class="flex items-center px-3 py-2 text-amber-600 hover:bg-amber-50 rounded-lg transition-all duration-150">
                                                    <i class="fas fa-crown text-amber-500 w-5 mr-3"></i>
                                                    <span>Admin Dashboard</span>
                                                </a>
                                            </div>
                                        <% } %>
                                        
                                        <div class="border-t border-gray-100 my-2 pt-2">
                                            <a href="/logout" class="flex items-center px-3 py-2 text-red-600 hover:bg-red-50 rounded-lg transition-all duration-150">
                                                <i class="fas fa-sign-out-alt w-5 mr-3"></i>
                                                <span>Logout</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- Mobile Menu Button -->
                    <button onclick="toggleMobileMenu()" class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg bg-gray-100 hover:bg-gray-200 transition-all duration-200">
                        <i class="fas fa-bars text-gray-700"></i>
                    </button>
                </div>
            </div>

            <!-- Mobile Menu -->
            <div id="mobileMenu" class="mobile-menu md:hidden bg-white rounded-lg shadow-lg border border-gray-200 mt-2 mb-4">
                <div class="p-4 space-y-3">
                    <a href="/" class="flex items-center px-4 py-3 text-gray-700 hover:bg-blue-50 rounded-lg transition-all duration-150">
                        <i class="fas fa-home text-blue-500 w-5 mr-3"></i>
                        <span class="font-medium">Home</span>
                    </a>
                    
                    <a href="/listings" class="flex items-center px-4 py-3 text-gray-700 hover:bg-blue-50 rounded-lg transition-all duration-150">
                        <i class="fas fa-search text-green-500 w-5 mr-3"></i>
                        <span class="font-medium">Browse Listings</span>
                    </a>
                    
                    <% if(currentUser) { %>
                        <a href="/listings/new" class="flex items-center px-4 py-3 text-white bg-gradient-to-r from-blue-500 to-blue-600 rounded-lg transition-all duration-150">
                            <i class="fas fa-plus-circle w-5 mr-3"></i>
                            <span class="font-medium">Create Listing</span>
                        </a>
                        
                        <a href="/users/profile" class="flex items-center px-4 py-3 text-gray-700 hover:bg-blue-50 rounded-lg transition-all duration-150">
                            <i class="fas fa-user-circle text-purple-500 w-5 mr-3"></i>
                            <span class="font-medium">My Profile</span>
                        </a>
                        
                        <!-- REMOVED: My Listings link from mobile menu -->
                        <!-- <a href="/users/listings" class="flex items-center px-4 py-3 text-gray-700 hover:bg-blue-50 rounded-lg transition-all duration-150">
                            <i class="fas fa-home text-green-500 w-5 mr-3"></i>
                            <span class="font-medium">My Listings</span>
                        </a> -->
                        
                        <% if(currentUser.role === 'admin') { %>
                            <a href="/admin/dashboard" class="flex items-center px-4 py-3 text-gray-700 hover:bg-amber-50 rounded-lg transition-all duration-150">
                                <i class="fas fa-crown text-amber-500 w-5 mr-3"></i>
                                <span class="font-medium">Admin Dashboard</span>
                            </a>
                        <% } %>
                        
                        <div class="border-t border-gray-200 pt-3 mt-3">
                            <a href="/logout" class="flex items-center px-4 py-3 text-red-600 hover:bg-red-50 rounded-lg transition-all duration-150">
                                <i class="fas fa-sign-out-alt w-5 mr-3"></i>
                                <span class="font-medium">Logout</span>
                            </a>
                        </div>
                    <% } else { %>
                        <div class="space-y-3 pt-2">
                            <a href="/login" class="block px-4 py-3 text-center text-gray-700 hover:bg-blue-50 rounded-lg transition-all duration-150 border border-gray-200">
                                <i class="fas fa-sign-in-alt mr-2"></i>Login
                            </a>
                            <a href="/register" class="block px-4 py-3 text-center text-white bg-gradient-to-r from-blue-500 to-blue-600 rounded-lg transition-all duration-150">
                                <i class="fas fa-user-plus mr-2"></i>Register
                            </a>
                        </div>
                    <% } %>
                    
                    <% if(currentUser) { %>
                        <div class="border-t border-gray-200 pt-3 mt-3">
                            <div class="flex items-center px-4 py-3 bg-gray-50 rounded-lg">
                                <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-500 rounded-full flex items-center justify-center text-white font-semibold mr-3">
                                    <% if(currentUser.firstName) { %>
                                        <%= currentUser.firstName.charAt(0).toUpperCase() %>
                                    <% } else { %>
                                        <%= currentUser.username.charAt(0).toUpperCase() %>
                                    <% } %>
                                </div>
                                <div>
                                    <p class="font-semibold text-gray-800">
                                        <%= currentUser.firstName || currentUser.username %>
                                    </p>
                                    <p class="text-xs text-gray-500">
                                        <% if(currentUser.role === 'admin') { %>
                                            <span class="text-amber-600 font-medium">Admin</span>
                                        <% } else if(currentUser.role === 'host') { %>
                                            <span class="text-blue-600 font-medium">Host</span>
                                        <% } else { %>
                                            <span class="text-gray-600">User</span>
                                        <% } %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <script>
        function toggleDropdown() {
            const dropdown = document.getElementById('userDropdown');
            dropdown.classList.toggle('show');
        }

        function toggleMobileMenu() {
            const mobileMenu = document.getElementById('mobileMenu');
            mobileMenu.classList.toggle('show');
        }

        document.addEventListener('click', function(event) {
            const dropdown = document.getElementById('userDropdown');
            const dropdownButton = event.target.closest('button');
            
            if (!dropdownButton && dropdown && dropdown.classList.contains('show')) {
                dropdown.classList.remove('show');
            }
        });

        document.querySelectorAll('#mobileMenu a').forEach(link => {
            link.addEventListener('click', () => {
                const mobileMenu = document.getElementById('mobileMenu');
                mobileMenu.classList.remove('show');
            });
        });

        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const dropdown = document.getElementById('userDropdown');
                if (dropdown && dropdown.classList.contains('show')) {
                    dropdown.classList.remove('show');
                }
            }
        });
    </script>
</body>
</html>