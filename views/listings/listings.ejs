<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Browse Listings - StayFinder</title>
    <style>
        /* Reset and Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: system-ui, -apple-system, sans-serif;
        }
        
        body {
            min-height: 100vh;
            background-color: #f9fafb;
        }
        
        /* Layout */
        .min-h-screen {
            min-height: 100vh;
        }
        
        .flex {
            display: flex;
        }
        
        /* Filter Sidebar */
        .w-64 {
            width: 16rem;
        }
        
        .flex-shrink-0 {
            flex-shrink: 0;
        }
        
        .sticky {
            position: sticky;
        }
        
        .top-0 {
            top: 0;
        }
        
        .h-screen {
            height: 100vh;
        }
        
        .overflow-y-auto {
            overflow-y: auto;
        }
        
        .bg-white {
            background-color: white;
        }
        
        .border-r {
            border-right-width: 1px;
        }
        
        .border-gray-200 {
            border-color: #e5e7eb;
        }
        
        .p-4 {
            padding: 1rem;
        }
        
        .mb-6 {
            margin-bottom: 1.5rem;
        }
        
        .text-xl {
            font-size: 1.25rem;
            line-height: 1.75rem;
        }
        
        .font-bold {
            font-weight: 700;
        }
        
        .text-gray-900 {
            color: #111827;
        }
        
        /* Filter Inputs */
        .mb-4 {
            margin-bottom: 1rem;
        }
        
        .block {
            display: block;
        }
        
        .text-sm {
            font-size: 0.875rem;
            line-height: 1.25rem;
        }
        
        .font-medium {
            font-weight: 500;
        }
        
        .text-gray-700 {
            color: #374151;
        }
        
        .mb-1 {
            margin-bottom: 0.25rem;
        }
        
        .w-full {
            width: 100%;
        }
        
        .px-3 {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }
        
        .py-2 {
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
        }
        
        .border {
            border-width: 1px;
        }
        
        .border-gray-300 {
            border-color: #d1d5db;
        }
        
        .rounded-lg {
            border-radius: 0.5rem;
        }
        
        .focus\:ring-2:focus {
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.5);
        }
        
        .focus\:ring-blue-500:focus {
            --tw-ring-color: #3b82f6;
        }
        
        .focus\:border-blue-500:focus {
            border-color: #3b82f6;
        }
        
        .outline-none {
            outline: 2px solid transparent;
            outline-offset: 2px;
        }
        
        .transition {
            transition-property: all;
            transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
            transition-duration: 150ms;
        }
        
        .flex {
            display: flex;
        }
        
        .items-center {
            align-items: center;
        }
        
        .mr-2 {
            margin-right: 0.5rem;
        }
        
        .ml-auto {
            margin-left: auto;
        }
        
        .grid {
            display: grid;
        }
        
        .grid-cols-2 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        
        .gap-3 {
            gap: 0.75rem;
        }
        
        /* Buttons */
        .gap-2 {
            gap: 0.5rem;
        }
        
        .flex-1 {
            flex: 1 1 0%;
        }
        
        .bg-blue-600 {
            background-color: #2563eb;
        }
        
        .text-white {
            color: white;
        }
        
        .py-2 {
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
        }
        
        .px-4 {
            padding-left: 1rem;
            padding-right: 1rem;
        }
        
        .rounded-lg {
            border-radius: 0.5rem;
        }
        
        .hover\:bg-blue-700:hover {
            background-color: #1d4ed8;
        }
        
        .bg-gray-200 {
            background-color: #e5e7eb;
        }
        
        .text-gray-800 {
            color: #1f2937;
        }
        
        .hover\:bg-gray-300:hover {
            background-color: #d1d5db;
        }
        
        /* Main Content Area */
        .flex-1 {
            flex: 1 1 0%;
        }
        
        .p-4 {
            padding: 1rem;
        }
        
        @media (min-width: 1024px) {
            .lg\:p-6 {
                padding: 1.5rem;
            }
        }
        
        /* No Listings State */
        .text-center {
            text-align: center;
        }
        
        .py-16 {
            padding-top: 4rem;
            padding-bottom: 4rem;
        }
        
        .w-16 {
            width: 4rem;
        }
        
        .h-16 {
            height: 4rem;
        }
        
        .text-gray-400 {
            color: #9ca3af;
        }
        
        .mx-auto {
            margin-left: auto;
            margin-right: auto;
        }
        
        .mb-4 {
            margin-bottom: 1rem;
        }
        
        .font-semibold {
            font-weight: 600;
        }
        
        .mb-2 {
            margin-bottom: 0.5rem;
        }
        
        .text-gray-500 {
            color: #6b7280;
        }
        
        /* Grid Layout */
        .grid {
            display: grid;
        }
        
        @media (min-width: 640px) {
            .sm\:grid-cols-1 {
                grid-template-columns: repeat(1, minmax(0, 1fr));
            }
        }
        
        @media (min-width: 768px) {
            .md\:grid-cols-2 {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }
        
        @media (min-width: 1024px) {
            .lg\:grid-cols-3 {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }
        
        .gap-6 {
            gap: 1.5rem;
        }
        
        /* Listing Cards */
        .block {
            display: block;
        }
        
        .bg-white {
            background-color: white;
        }
        
        .rounded-lg {
            border-radius: 0.5rem;
        }
        
        .shadow-sm {
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }
        
        .hover\:shadow-md:hover {
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        
        .transition-all {
            transition-property: all;
            transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
            transition-duration: 150ms;
        }
        
        .duration-200 {
            transition-duration: 200ms;
        }
        
        .overflow-hidden {
            overflow: hidden;
        }
        
        .border {
            border-width: 1px;
        }
        
        .border-gray-200 {
            border-color: #e5e7eb;
        }
        
        /* Image Container */
        .relative {
            position: relative;
        }
        
        .h-48 {
            height: 12rem;
        }
        
        .w-full {
            width: 100%;
        }
        
        .overflow-hidden {
            overflow: hidden;
        }
        
        .bg-gray-100 {
            background-color: #f3f4f6;
        }
        
        /* Image Styling */
        img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .hover\:scale-105:hover {
            transform: scale(1.05);
        }
        
        .transition-transform {
            transition-property: transform;
            transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
            transition-duration: 150ms;
        }
        
        .duration-300 {
            transition-duration: 300ms;
        }
        
        /* Rating Badge */
        .absolute {
            position: absolute;
        }
        
        .top-3 {
            top: 0.75rem;
        }
        
        .right-3 {
            right: 0.75rem;
        }
        
        .backdrop-blur-sm {
            backdrop-filter: blur(4px);
        }
        
        .px-2 {
            padding-left: 0.5rem;
            padding-right: 0.5rem;
        }
        
        .py-1 {
            padding-top: 0.25rem;
            padding-bottom: 0.25rem;
        }
        
        .rounded-full {
            border-radius: 9999px;
        }
        
        .items-center {
            align-items: center;
        }
        
        .gap-1 {
            gap: 0.25rem;
        }
        
        .shadow-sm {
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }
        
        .text-yellow-500 {
            color: #eab308;
        }
        
        .fill-current {
            fill: currentColor;
        }
        
        .w-4 {
            width: 1rem;
        }
        
        .h-4 {
            height: 1rem;
        }
        
        /* Card Content */
        .p-4 {
            padding: 1rem;
        }
        
        .font-semibold {
            font-weight: 600;
        }
        
        .mb-1 {
            margin-bottom: 0.25rem;
        }
        
        .truncate {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        
        .text-gray-600 {
            color: #4b5563;
        }
        
        .mb-3 {
            margin-bottom: 0.75rem;
        }
        
        .justify-between {
            justify-content: space-between;
        }
        
        .font-bold {
            font-weight: 700;
        }
        
        .text-xs {
            font-size: 0.75rem;
            line-height: 1rem;
        }

        /* Star rating styles */
        .star-rating {
            display: flex;
            align-items: center;
            gap: 2px;
        }
        
        .star {
            color: #d1d5db;
        }
        
        .star.filled {
            color: #fbbf24;
        }
        
        .star.half {
            position: relative;
            color: #d1d5db;
        }
        
        .star.half::before {
            content: '★';
            position: absolute;
            width: 50%;
            overflow: hidden;
            color: #fbbf24;
        }
    </style>
</head>
<body>
<div class="min-h-screen flex">
  <!-- STICKY LEFT FILTER BAR -->
  <div class="w-64 flex-shrink-0 sticky top-0 h-screen overflow-y-auto bg-white border-r border-gray-200 p-4">
    <div class="mb-6">
      <h3 class="text-xl font-bold text-gray-900">Filters</h3>
    </div>

    <!-- Country Filter -->
    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Country</label>
      <input 
        type="text" 
        id="countryInput"
        placeholder="Search for a country..."
        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition"
        value=""
      >
    </div>

    <!-- Price Range -->
    <div class="mb-6">
      <label class="block text-sm font-medium text-gray-700 mb-1">Price Range</label>
      <div class="flex items-center mb-2">
        <span class="text-sm text-gray-600 mr-2">Min: $<span id="minPriceValue">0</span></span>
        <span class="text-sm text-gray-600 ml-auto">Max: $<span id="maxPriceValue">60000</span></span>
      </div>
      
      <div class="grid grid-cols-2 gap-3">
        <div>
          <input 
            type="number" 
            id="minPrice"
            min="0"
            max="60000"
            value="0"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition"
            placeholder="Min"
          >
        </div>
        <div>
          <input 
            type="number" 
            id="maxPrice"
            min="0"
            max="60000"
            value="60000"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition"
            placeholder="Max"
          >
        </div>
      </div>
    </div>

    <!-- Filter Buttons -->
    <div class="flex gap-2">
      <button 
        id="applyFilters"
        class="flex-1 bg-blue-600 text-white py-2 px-4 rounded-lg hover:bg-blue-700 transition font-medium"
      >
        Apply
      </button>
      <button 
        id="clearFilters"
        class="flex-1 bg-gray-200 text-gray-800 py-2 px-4 rounded-lg hover:bg-gray-300 transition font-medium"
      >
        Clear
      </button>
    </div>
  </div>

  <!-- MAIN LISTINGS AREA -->
  <div class="flex-1 p-4 lg:p-6">
    <!-- LISTINGS GRID -->
    <% if (allListings && allListings.length === 0) { %>
      <div class="text-center py-16">
        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 4rem; height: 4rem; color: #9ca3af; margin: 0 auto; margin-bottom: 1rem;">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
        </svg>
        <h3 class="text-xl font-semibold text-gray-700 mb-2" style="font-size: 1.25rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem;">No Listings Found</h3>
        <p class="text-gray-500" style="color: #6b7280;">
          No listings available yet
        </p>
      </div>
    <% } %>

    <% if (allListings && allListings.length > 0) { %>
    <div class="grid sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% for(let listing of allListings) { %>
        <a href="/listings/<%= listing._id %>" class="block">
          <div class="bg-white rounded-lg shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden border border-gray-200">
            
            <!-- IMAGE -->
            <div class="relative h-48 w-full overflow-hidden bg-gray-100">
              <% if (listing.media && listing.media.length > 0 && listing.media[0].url) { %>
                <img
                  src="<%= listing.media[0].url %>"
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                  alt="<%= listing.title %>"
                  onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1518780664697-55e3ad937233?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80'"
                  style="width: 100%; height: 100%; object-fit: cover;"
                >
              <% } else { %>
                <div class="w-full h-full bg-gray-100 flex items-center justify-center">
                  <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 3rem; height: 3rem; color: #9ca3af;">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                </div>
              <% } %>
              
              <!-- RATING BADGE - Only show if there are ratings -->
              <div class="absolute top-3 right-3" style="position: absolute; top: 0.75rem; right: 0.75rem;">
                <% if (listing.averageRating > 0) { %>
                  <div class="bg-white/90 backdrop-blur-sm px-2 py-1 rounded-full flex items-center gap-1 shadow-sm">
                    <!-- Star display -->
                    <div class="star-rating">
                      <% for(let i = 1; i <= 5; i++) { %>
                        <% if (i <= Math.floor(listing.averageRating)) { %>
                          <span class="star filled">★</span>
                        <% } else if (i === Math.ceil(listing.averageRating) && listing.averageRating % 1 !== 0) { %>
                          <span class="star half">★</span>
                        <% } else { %>
                          <span class="star">☆</span>
                        <% } %>
                      <% } %>
                    </div>
                    
                    <!-- Rating number -->
                    <span class="text-sm font-medium ml-1"><%= listing.averageRating.toFixed(1) %></span>
                    
                    <!-- Review count -->
                    <% if (listing.reviewsCount > 0) { %>
                      <span class="text-xs text-gray-600">(<%= listing.reviewsCount %>)</span>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="bg-white/90 backdrop-blur-sm px-2 py-1 rounded-full shadow-sm">
                    <span class="text-sm text-gray-500">No ratings</span>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- CARD CONTENT -->
            <div class="p-4">
              <!-- Title -->
              <h3 class="font-semibold text-gray-900 mb-1 truncate"><%= listing.title %></h3>
              
              <!-- Location -->
              <p class="text-gray-600 text-sm mb-3">
                <%= listing.location %>, <%= listing.country %>
              </p>
              
              <!-- Price & Reviews -->
              <div class="flex items-center justify-between">
                <div>
                  <span class="font-bold text-gray-900">$<%= listing.price.toLocaleString("en-IN") %></span>
                  <span class="text-gray-600 text-sm"> / night</span>
                </div>
                
                <!-- Reviews count - SIMPLIFIED VERSION -->
                <% if (listing.averageRating > 0 && listing.reviewsCount > 0) { %>
                  <div class="flex items-center text-sm text-gray-600">
                    <span>★ <%= listing.averageRating.toFixed(1) %> (<%= listing.reviewsCount %>)</span>
                  </div>
                <% } else if (listing.reviewsCount === 0) { %>
                  <span class="text-sm text-gray-500">No reviews</span>
                <% } %>
              </div>
            </div>
          </div>
        </a>
      <% } %>
    </div>
    <% } %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const countryInput = document.getElementById('countryInput');
    const minPriceInput = document.getElementById('minPrice');
    const maxPriceInput = document.getElementById('maxPrice');
    const minPriceValue = document.getElementById('minPriceValue');
    const maxPriceValue = document.getElementById('maxPriceValue');
    const applyFiltersBtn = document.getElementById('applyFilters');
    const clearFiltersBtn = document.getElementById('clearFilters');

    // Update price display
    function updatePriceDisplay() {
      const minVal = parseInt(minPriceInput.value) || 0;
      const maxVal = parseInt(maxPriceInput.value) || 60000;
      
      minPriceValue.textContent = minVal.toLocaleString('en-US');
      maxPriceValue.textContent = maxVal.toLocaleString('en-US');
    }

    updatePriceDisplay();

    minPriceInput.addEventListener('input', updatePriceDisplay);
    maxPriceInput.addEventListener('input', updatePriceDisplay);

    // Validate price range
    minPriceInput.addEventListener('change', function() {
      const min = parseInt(this.value) || 0;
      const max = parseInt(maxPriceInput.value) || 60000;
      
      if (min > max) {
        maxPriceInput.value = min;
        updatePriceDisplay();
      }
    });

    maxPriceInput.addEventListener('change', function() {
      const min = parseInt(minPriceInput.value) || 0;
      const max = parseInt(this.value) || 60000;
      
      if (max < min) {
        minPriceInput.value = max;
        updatePriceDisplay();
      }
    });

    // Apply filters
    function applyFilters() {
      const country = countryInput.value.trim();
      const minPrice = minPriceInput.value;
      const maxPrice = maxPriceInput.value;

      const params = new URLSearchParams();
      
      if (country) params.append('country', country);
      if (minPrice && minPrice !== '0') params.append('minPrice', minPrice);
      if (maxPrice && maxPrice !== '60000') params.append('maxPrice', maxPrice);

      applyFiltersBtn.innerHTML = 'Applying...';
      applyFiltersBtn.disabled = true;

      setTimeout(() => {
        window.location.href = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
      }, 300);
    }

    // Clear filters
    function clearFilters() {
      countryInput.value = '';
      minPriceInput.value = '0';
      maxPriceInput.value = '60000';
      updatePriceDisplay();
      
      clearFiltersBtn.innerHTML = 'Clearing...';
      clearFiltersBtn.disabled = true;
      
      setTimeout(() => {
        window.location.href = window.location.pathname;
      }, 300);
    }

    // Event listeners
    applyFiltersBtn.addEventListener('click', applyFilters);
    clearFiltersBtn.addEventListener('click', clearFilters);

    // Enter key to apply filters
    countryInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        applyFilters();
      }
    });
  });
</script>
</body>
</html>