            crossorigin=""></script>

    <script>
        // Rating functionality
        function setRating(rating) {
            document.getElementById('selectedRating').value = rating;
            
            for(let i = 1; i <= 5; i++) {
                const star = document.getElementById('star' + i);
                if (i <= rating) {
                    star.classList.add('active');
                } else {
                    star.classList.remove('active');
                }
            }
        }

        // Character counter
        function countChars(textarea) {
            const charCount = document.getElementById('charCount');
            const currentLength = textarea.value.length;
            charCount.textContent = `${currentLength}/500`;
            
            if (currentLength > 450) {
                charCount.style.color = '#ef4444';
            } else {
                charCount.style.color = 'var(--airbnb-gray)';
            }
        }

        // Like toggle
        async function toggleLike() {
            const likeButton = document.getElementById('likeButton');
            const heartIcon = likeButton.querySelector('.heart-icon');
            const likeCountSpan = document.getElementById('likeCount');
            
            try {
                const response = await fetch(`/listings/<%= listing._id %>/like`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    credentials: 'same-origin'
                });
                
                if (response.ok) {
                    const data = await response.json();
                    
                    likeCountSpan.textContent = data.likesCount;
                    
                    if (data.liked) {
                        likeButton.classList.add('liked');
                        heartIcon.classList.remove('empty');
                        heartIcon.classList.add('filled');
                    } else {
                        likeButton.classList.remove('liked');
                        heartIcon.classList.remove('filled');
                        heartIcon.classList.add('empty');
                    }
                }
            } catch (error) {
                console.error('Error toggling like:', error);
            }
        }

        // Initialize map
        async function initializeMap() {
            const address = '<%= listing.location %>, <%= listing.country %>';
            
            try {
                const response = await fetch(
                    `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}&limit=1`
                );
                
                const data = await response.json();
                
                if (data.length === 0) {
                    throw new Error('Location not found');
                }
                
                const lat = parseFloat(data[0].lat);
                const lon = parseFloat(data[0].lon);
                
                const map = L.map('map').setView([lat, lon], 13);
                
                L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '© OpenStreetMap'
                }).addTo(map);
                
                const marker = L.marker([lat, lon]).addTo(map);
                
                marker.bindPopup(`
                    <div style="padding: 8px;">
                        <strong><%= listing.title %></strong><br>
                        <span style="color: #666; font-size: 12px;"><%= listing.location %>, <%= listing.country %></span>
                    </div>
                `).openPopup();
                
            } catch (error) {
                console.error('Map error:', error);
                document.getElementById('map').innerHTML = '<div style="display: flex; align-items: center; justify-content: center; height: 100%; color: var(--airbnb-gray);">Map unavailable</div>';
            }
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            initializeMap();
            
            // Initialize character counter
            const textarea = document.querySelector('textarea[name="review[comment]"]');
            if (textarea) {
                countChars(textarea);
            }
        });
    </script>
</body>
</html>