<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Edit Listing - StayFinder' %></title>
    <style>
        /* ========== MOBILE FIRST STYLES (320px-767px) ========== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        
        body {
            background-color: #f5f5f5;
            min-height: 100vh;
            padding: 0;
            font-size: 14px;
        }
        
        .container {
            width: 100%;
            margin: 0 auto;
            background: white;
            padding: 16px;
        }
        
        h1 {
            font-size: 20px;
            font-weight: 700;
            color: #111827;
            margin-bottom: 24px;
            padding-bottom: 12px;
            border-bottom: 2px solid #e5e7eb;
        }
        
        .form-grid {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-bottom: 24px;
        }
        
        .form-group {
            margin-bottom: 16px;
            width: 100%;
        }
        
        label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            color: #374151;
            margin-bottom: 6px;
        }
        
        .required::after {
            content: " *";
            color: #dc3545;
        }
        
        input, textarea, select {
            width: 100%;
            padding: 14px 16px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 16px; /* Larger for mobile touch */
            transition: all 0.2s;
            background: white;
        }
        
        input:focus, textarea:focus, select:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }
        
        textarea {
            resize: vertical;
            min-height: 120px;
        }
        
        /* Validation Styles */
        .form-control.error {
            border-color: #dc3545;
        }
        
        .form-control.success {
            border-color: #198754;
        }
        
        .character-count {
            font-size: 12px;
            color: #6c757d;
            margin-top: 4px;
        }
        
        .character-count.near-limit {
            color: #ffc107;
        }
        
        .character-count.over-limit {
            color: #dc3545;
        }
        
        /* Section Titles */
        .section-title {
            font-size: 18px;
            font-weight: 600;
            color: #111827;
            margin: 32px 0 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        /* Upload Section */
        .upload-section {
            margin: 32px 0;
            padding-top: 20px;
            border-top: 1px solid #e5e7eb;
        }
        
        /* Upload Area - Mobile: 90vw width, 150px height */
        .upload-area {
            border: 2px dashed #d1d5db;
            border-radius: 12px;
            padding: 30px 16px;
            text-align: center;
            background-color: #f9fafb;
            cursor: pointer;
            transition: all 0.2s;
            margin-bottom: 24px;
            width: 90vw;
            height: 150px;
            max-width: 100%;
            margin-left: auto;
            margin-right: auto;
        }
        
        .upload-area:hover, .upload-area.dragover {
            border-color: #2563eb;
            background-color: #eff6ff;
        }
        
        .upload-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
        }
        
        .upload-icon {
            width: 40px;
            height: 40px;
            color: #6b7280;
        }
        
        .upload-text h3 {
            font-size: 16px;
            font-weight: 600;
            color: #111827;
            margin-bottom: 4px;
        }
        
        .upload-text p {
            color: #6b7280;
            font-size: 12px;
            margin-bottom: 8px;
        }
        
        .choose-btn {
            display: inline-block;
            padding: 12px 24px;
            background-color: #2563eb;
            color: white;
            border-radius: 8px;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.2s;
            font-size: 16px;
            min-height: 44px; /* Touch target */
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .choose-btn:hover {
            background-color: #1d4ed8;
        }
        
        .file-input {
            display: none;
        }
        
        /* Media Grid - Mobile: 2 images per row */
        .media-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 24px;
        }
        
        /* Media Item */
        .media-item {
            position: relative;
            border-radius: 8px;
            overflow: hidden;
            background-color: #f3f4f6;
            aspect-ratio: 1/1;
            cursor: pointer;
            transition: all 0.2s;
        }
        
        /* Media Preview */
        .media-preview {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .media-info {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 8px;
            font-size: 10px;
            z-index: 2;
        }
        
        /* New Media Item */
        .new-media-item {
            position: relative;
            border-radius: 8px;
            overflow: hidden;
            background-color: #f3f4f6;
            aspect-ratio: 1/1;
            animation: fadeIn 0.3s ease-in;
        }
        
        .new-badge {
            position: absolute;
            top: 8px;
            left: 8px;
            background-color: #10b981;
            color: white;
            font-size: 10px;
            font-weight: 600;
            padding: 4px 8px;
            border-radius: 12px;
            z-index: 2;
        }
        
        /* Form Actions - Mobile: Full-width, stacked */
        .form-actions {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 32px;
            padding-top: 20px;
            border-top: 1px solid #e5e7eb;
        }
        
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 14px 24px;
            border-radius: 8px;
            font-weight: 500;
            text-decoration: none;
            border: 1px solid transparent;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 16px;
            width: 100%;
            min-height: 44px; /* Touch target */
        }
        
        .save-btn {
            background-color: #2563eb;
            color: white;
        }
        
        .save-btn:hover {
            background-color: #1d4ed8;
        }
        
        .back-btn {
            background-color: white;
            color: #374151;
            border-color: #d1d5db;
        }
        
        .back-btn:hover {
            background-color: #f9fafb;
        }
        
        /* Flash Messages */
        .flash-messages {
            margin-bottom: 16px;
        }
        
        .alert {
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 8px;
            font-size: 14px;
        }
        
        .alert-success {
            background-color: #d1fae5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }
        
        .alert-error {
            background-color: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }
        
        /* Client Alert - Airbnb Pink Style */
        #clientAlert {
            margin-bottom: 20px;
            position: relative;
            display: none;
        }
        
        #clientAlert .airbnb-alert {
            background-color: #FF5A5F; /* Airbnb pink */
            color: white;
            border-radius: 12px;
            padding: 20px 50px 20px 20px;
            box-shadow: 0 8px 30px rgba(255, 90, 95, 0.25);
            border: none;
            position: relative;
            animation: slideDown 0.3s ease-out;
            margin-bottom: 24px;
        }
        
        #clientAlert .airbnb-alert .alert-title {
            font-weight: 600;
            font-size: 16px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        #clientAlert .airbnb-alert .alert-title svg {
            width: 20px;
            height: 20px;
        }
        
        #clientAlert .airbnb-alert .alert-body {
            font-size: 14px;
            line-height: 1.5;
        }
        
        #clientAlert .airbnb-alert ul {
            margin: 10px 0 0 0;
            padding-left: 20px;
        }
        
        #clientAlert .airbnb-alert ul li {
            margin-bottom: 6px;
        }
        
        #clientAlert .airbnb-alert ul li:last-child {
            margin-bottom: 0;
        }
        
        /* White X Close Button */
        #clientAlert .airbnb-alert .close-btn {
            position: absolute;
            top: 16px;
            right: 16px;
            background: none;
            border: none;
            color: white;
            font-size: 28px;
            line-height: 1;
            cursor: pointer;
            padding: 0;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: background-color 0.2s;
        }
        
        #clientAlert .airbnb-alert .close-btn:hover {
            background-color: rgba(255, 255, 255, 0.2);
        }
        
        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* ========== TABLET STYLES (768px-1023px) ========== */
        @media (min-width: 768px) {
            body {
                font-size: 16px;
                padding: 24px;
            }
            
            .container {
                max-width: 90%;
                padding: 24px;
                border-radius: 12px;
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
            }
            
            h1 {
                font-size: 24px;
                margin-bottom: 30px;
            }
            
            .form-grid {
                gap: 20px;
            }
            
            .form-group {
                margin-bottom: 20px;
            }
            
            .media-grid {
                grid-template-columns: repeat(3, 1fr); /* Tablet: 3 images per row */
                gap: 16px;
            }
            
            .upload-area {
                width: 80vw;
                height: 180px;
                padding: 40px 20px;
            }
            
            .upload-text h3 {
                font-size: 18px;
            }
            
            .upload-text p {
                font-size: 14px;
            }
            
            .form-actions {
                flex-direction: row;
                gap: 16px;
            }
            
            .btn {
                width: auto;
                flex: 1;
            }
            
            .section-title {
                font-size: 20px;
            }
        }
        
        /* ========== LAPTOP STYLES (1024px-1439px) ========== */
        @media (min-width: 1024px) {
            .container {
                max-width: 1200px;
                padding: 32px;
            }
            
            .form-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr); /* Laptop: Two-column grid */
                gap: 24px;
            }
            
            .form-group.full-width {
                grid-column: 1 / -1;
            }
            
            .media-grid {
                grid-template-columns: repeat(4, 1fr); /* Laptop: 4-5 images per row */
                gap: 20px;
            }
            
            .upload-area {
                width: 100%;
                height: 200px;
            }
            
            .form-actions {
                justify-content: flex-start;
            }
            
            .btn {
                flex: 0 1 auto;
                padding: 12px 24px;
            }
        }
        
        /* ========== DESKTOP STYLES (1440px+) ========== */
        @media (min-width: 1440px) {
            .container {
                max-width: 1400px;
                padding: 40px;
            }
            
            h1 {
                font-size: 28px;
            }
            
            .media-grid {
                grid-template-columns: repeat(5, 1fr); /* Desktop: 5 images per row */
            }
            
            .section-title {
                font-size: 22px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Edit Listing</h1>
        
        <!-- Flash Messages -->
        <div class="flash-messages">
            <% if (success && success.length > 0) { %>
                <div class="alert alert-success"><%= success %></div>
            <% } %>
            <% if (error && error.length > 0) { %>
                <div class="alert alert-error"><%= error %></div>
            <% } %>
        </div>
        
        <!-- Client-side validation alert -->
        <div id="clientAlert" style="display: none;"></div>
        
        <!-- Edit Form -->
        <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" enctype="multipart/form-data" id="editForm">
            <div class="form-grid">
                <!-- Title -->
                <div class="form-group">
                    <label for="title" class="required">Title</label>
                    <input 
                        type="text" 
                        id="title" 
                        name="title" 
                        value="<%= listing.title %>" 
                        placeholder="Enter listing title"
                        maxlength="100"
                        class="form-control"
                    >
                    <div class="character-count" id="titleCount"><%= listing.title ? listing.title.length : 0 %>/100 characters</div>
                </div>
                
                <!-- Price -->
                <div class="form-group">
                    <label for="price" class="required">Price (per night)</label>
                    <input 
                        type="number" 
                        id="price" 
                        name="price" 
                        value="<%= listing.price %>" 
                        placeholder="Enter price"
                        min="50"
                        max="10000"
                        step="0.01"
                        class="form-control"
                    >
                    <div class="form-text">Price per night ($50 - $10,000)</div>
                </div>
                
                <!-- Description -->
                <div class="form-group full-width">
                    <label for="description" class="required">Description</label>
                    <textarea 
                        id="description" 
                        name="description" 
                        placeholder="Describe your property..."
                        maxlength="2000"
                        class="form-control"
                    ><%= listing.description %></textarea>
                    <div class="character-count" id="descriptionCount"><%= listing.description ? listing.description.length : 0 %>/2000 characters</div>
                </div>
                
                <!-- Location -->
                <div class="form-group">
                    <label for="location" class="required">Location</label>
                    <input 
                        type="text" 
                        id="location" 
                        name="location" 
                        value="<%= listing.location %>" 
                        placeholder="City, State, etc."
                        maxlength="200"
                        class="form-control"
                    >
                    <div class="character-count" id="locationCount"><%= listing.location ? listing.location.length : 0 %>/200 characters</div>
                </div>
                
                <!-- Country -->
                <div class="form-group">
                    <label for="country" class="required">Country</label>
                    <input 
                        type="text" 
                        id="country" 
                        name="country" 
                        value="<%= listing.country %>" 
                        placeholder="e.g., India, USA, Germany, etc."
                        maxlength="100"
                        class="form-control"
                    >
                    <div class="character-count" id="countryCount"><%= listing.country ? listing.country.length : 0 %>/100 characters</div>
                </div>
            </div>
            
            <!-- EXISTING MEDIA SECTION -->
            <div class="upload-section">
                <h2 class="section-title">
                    <svg style="width: 24px; height: 24px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    Existing Media
                </h2>
                <p style="color: #6b7280; margin-bottom: 20px; font-size: 14px;">
                    Click on images/videos to select for deletion. Selected items will be removed when you save changes.
                </p>
                
                <% if (listing.media && listing.media.length > 0) { %>
                    <div class="media-grid" id="existingMediaGrid">
                        <% listing.media.forEach((item, index) => { %>
                            <div class="media-item existing-media" data-media-id="<%= item._id || index %>" data-type="existing">
                                <% if (item.mediaType === 'image') { %>
                                    <img 
                                        src="<%= item.url %>" 
                                        alt="Media <%= index + 1 %>"
                                        class="media-preview"
                                        onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1518780664697-55e3ad937233?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80'"
                                    >
                                <% } else { %>
                                    <video class="media-preview" controls>
                                        <source src="<%= item.url %>" type="video/mp4">
                                        Your browser does not support the video tag.
                                    </video>
                                <% } %>
                                <div class="media-info">
                                    <%= item.filename || `Media ${index + 1}` %>
                                </div>
                                <!-- Hidden input to track media to keep -->
                                <input type="hidden" name="keepMedia[]" value="<%= item._id || index %>" class="keep-media-input">
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p style="color: #6b7280; font-style: italic; text-align: center; padding: 40px;">
                        No media files uploaded yet.
                    </p>
                <% } %>
            </div>
            
            <!-- UPLOAD NEW MEDIA SECTION -->
            <div class="upload-section">
                <h2 class="section-title">
                    <svg style="width: 24px; height: 24px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
                    </svg>
                    Upload New Media
                </h2>
                <p style="color: #6b7280; margin-bottom: 20px; font-size: 14px;">
                    Drag & drop files or click to browse. Supports images and videos. Max 12 files total.
                </p>
                
                <!-- Upload Area -->
                <div class="upload-area" id="uploadArea" onclick="document.getElementById('newMedia').click()">
                    <div class="upload-content">
                        <svg class="upload-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
                        </svg>
                        <div class="upload-text">
                            <h3>Drag & drop files here</h3>
                            <p style="font-size: 12px; color: #9ca3af;">Supports images (JPG, PNG) and videos (MP4). Max 10MB each.</p>
                        </div>
                        
                    </div>
                </div>
                
                <!-- Hidden file input -->
                <input 
                    type="file" 
                    id="newMedia" 
                    name="media" 
                    class="file-input" 
                    multiple 
                    accept="image/*,video/*"
                    onchange="handleFileSelect(event)"
                >
                
                <!-- Media preview grid -->
                <div class="media-grid" id="mediaPreviewGrid">
                    <!-- Preview items will be added here dynamically -->
                </div>
                
                <!-- New uploads info -->
                <div id="newUploadsInfo" style="display: none; background-color: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 15px; margin-top: 20px;">
                    <p style="color: #065f46; font-size: 14px; font-weight: 500;">
                        <svg style="width: 20px; height: 20px; display: inline; margin-right: 8px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        New files uploaded successfully. They will appear in the preview above.
                    </p>
                </div>
            </div>
            
            <!-- Form Actions -->
            <div class="form-actions">
                <button type="submit" class="btn save-btn" id="submitBtn" style="background-color:#FF5A5F;">
                    <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    Save Changes
                </button>
                
                <a href="/listings" class="btn back-btn">
                    <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    Back to Listings
                </a>
            </div>
        </form>
    </div>
    
    <script>
        // Get form elements
        const editForm = document.getElementById('editForm');
        const clientAlert = document.getElementById('clientAlert');
        const submitBtn = document.getElementById('submitBtn');
        
        // Get all form inputs
        const titleInput = document.getElementById('title');
        const descriptionInput = document.getElementById('description');
        const priceInput = document.getElementById('price');
        const locationInput = document.getElementById('location');
        const countryInput = document.getElementById('country');
        
        // Character counters
        const titleCount = document.getElementById('titleCount');
        const descriptionCount = document.getElementById('descriptionCount');
        const locationCount = document.getElementById('locationCount');
        const countryCount = document.getElementById('countryCount');
        
        // Track all new files
        let newFiles = [];
        // Track media items to delete
        let mediaToDelete = [];
        
        // Character counter updates
        function updateCharacterCount(input, counter, maxLength) {
            const length = input.value.length;
            counter.textContent = `${length}/${maxLength} characters`;
            
            if (length > maxLength * 0.9) {
                counter.className = 'character-count near-limit';
            } else if (length > maxLength) {
                counter.className = 'character-count over-limit';
            } else {
                counter.className = 'character-count';
            }
        }
        
        // Initialize character counters
        if (titleInput) titleInput.addEventListener('input', () => updateCharacterCount(titleInput, titleCount, 100));
        if (descriptionInput) descriptionInput.addEventListener('input', () => updateCharacterCount(descriptionInput, descriptionCount, 2000));
        if (locationInput) locationInput.addEventListener('input', () => updateCharacterCount(locationInput, locationCount, 200));
        if (countryInput) countryInput.addEventListener('input', () => updateCharacterCount(countryInput, countryCount, 100));
        
        // Remove validation styling when user starts typing
        function clearFieldStyling(input) {
            if (input) input.classList.remove('error', 'success');
        }
        
        // Add input listeners to clear styling
        const allInputs = [titleInput, descriptionInput, priceInput, locationInput, countryInput].filter(Boolean);
        allInputs.forEach(input => {
            input.addEventListener('input', function() {
                clearFieldStyling(this);
                if (clientAlert && clientAlert.style.display === 'block') {
                    clientAlert.style.display = 'none';
                    clientAlert.innerHTML = '';
                    clientAlert.className = '';
                }
            });
        });
        
        // Toggle media delete selection
        function toggleMediaDelete(mediaItem) {
            const mediaId = mediaItem.dataset.mediaId;
            const hiddenInput = mediaItem.querySelector('.keep-media-input');
            
            if (mediaToDelete.includes(mediaId)) {
                // Remove from delete list
                mediaToDelete = mediaToDelete.filter(id => id !== mediaId);
                mediaItem.style.border = 'none';
                if (hiddenInput) hiddenInput.disabled = false;
            } else {
                // Add to delete list
                mediaToDelete.push(mediaId);
                mediaItem.style.border = '3px solid #ef4444';
                if (hiddenInput) hiddenInput.disabled = true;
            }
        }
        
        // Handle file selection
        function handleFileSelect(event) {
            const files = event.target.files;
            const mediaPreviewGrid = document.getElementById('mediaPreviewGrid');
            
            // Process new files
            const newSelectedFiles = Array.from(files);
            
            if (newSelectedFiles.length > 0) {
                // Check total files won't exceed 12
                const existingItems = document.querySelectorAll('.existing-media');
                const existingNewItems = document.querySelectorAll('.new-media-item');
                const totalItems = (existingItems.length - mediaToDelete.length) + existingNewItems.length + newSelectedFiles.length;
                
                if (totalItems > 12) {
                    alert(`Maximum 12 files allowed. You have ${existingItems.length - mediaToDelete.length} existing files (after deletion) and ${existingNewItems.length} new files. Please select fewer files.`);
                    event.target.value = '';
                    return;
                }
                
                // Add each new file to the media preview grid
                newSelectedFiles.forEach((file, index) => {
                    // Check file size (max 10MB)
                    if (file.size > 10 * 1024 * 1024) {
                        alert(`File ${file.name} is too large. Maximum size is 10MB.`);
                        return;
                    }
                    
                    // Check file type
                    if (!file.type.startsWith('image/') && !file.type.startsWith('video/')) {
                        alert(`File ${file.name} is not an image or video.`);
                        return;
                    }
                    
                    const reader = new FileReader();
                    
                    reader.onload = function(e) {
                        const newMediaItem = document.createElement('div');
                        newMediaItem.className = 'new-media-item fade-in';
                        newMediaItem.dataset.fileIndex = newFiles.length;
                        newMediaItem.dataset.type = 'new';
                        
                        // Add "NEW" badge
                        const newBadge = document.createElement('div');
                        newBadge.className = 'new-badge';
                        newBadge.textContent = 'NEW';
                        newMediaItem.appendChild(newBadge);
                        
                        // Add media preview
                        if (file.type.startsWith('image/')) {
                            newMediaItem.innerHTML += `
                                <img src="${e.target.result}" class="media-preview" alt="${file.name}">
                                <div class="media-info">${file.name}</div>
                            `;
                        } else if (file.type.startsWith('video/')) {
                            newMediaItem.innerHTML += `
                                <video class="media-preview" controls>
                                    <source src="${e.target.result}" type="${file.type}">
                                </video>
                                <div class="media-info">${file.name}</div>
                            `;
                        }
                        
                        // Add to the newFiles array
                        const fileObj = {
                            file: file,
                            previewUrl: e.target.result
                        };
                        newFiles.push(fileObj);
                        
                        // Add to media preview grid
                        if (mediaPreviewGrid) mediaPreviewGrid.appendChild(newMediaItem);
                    };
                    
                    reader.readAsDataURL(file);
                });
                
                // Show upload success message
                const newUploadsInfo = document.getElementById('newUploadsInfo');
                if (newUploadsInfo) newUploadsInfo.style.display = 'block';
            } else {
                const newUploadsInfo = document.getElementById('newUploadsInfo');
                if (newUploadsInfo) newUploadsInfo.style.display = 'none';
            }
        }
        
        // Drag and drop functionality
        const uploadArea = document.getElementById('uploadArea');
        const fileInput = document.getElementById('newMedia');
        
        if (uploadArea && fileInput) {
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                uploadArea.addEventListener(eventName, preventDefaults, false);
            });
            
            function preventDefaults(e) {
                e.preventDefault();
                e.stopPropagation();
            }
            
            ['dragenter', 'dragover'].forEach(eventName => {
                uploadArea.addEventListener(eventName, highlight, false);
            });
            
            ['dragleave', 'drop'].forEach(eventName => {
                uploadArea.addEventListener(eventName, unhighlight, false);
            });
            
            function highlight() {
                uploadArea.classList.add('dragover');
            }
            
            function unhighlight() {
                uploadArea.classList.remove('dragover');
            }
            
            uploadArea.addEventListener('drop', handleDrop, false);
            
            function handleDrop(e) {
                const dt = e.dataTransfer;
                const files = dt.files;
                
                // Update file input
                const dataTransfer = new DataTransfer();
                Array.from(files).forEach(file => dataTransfer.items.add(file));
                fileInput.files = dataTransfer.files;
                
                // Trigger change event
                const event = new Event('change');
                fileInput.dispatchEvent(event);
            }
        }
        
        // Add click event to existing media items for deletion
        document.addEventListener('DOMContentLoaded', function() {
            const existingMediaItems = document.querySelectorAll('.existing-media');
            existingMediaItems.forEach(item => {
                item.addEventListener('click', function() {
                    toggleMediaDelete(this);
                });
            });
        });
        
        // Form submission handler
        if (editForm) {
            editForm.addEventListener('submit', function(event) {
                event.preventDefault();
                
                // Clear previous client alert and field styling
                if (clientAlert) {
                    clientAlert.style.display = 'none';
                    clientAlert.innerHTML = '';
                    clientAlert.className = '';
                }
                
                // Clear all field styling
                allInputs.forEach(input => {
                    if (input) input.classList.remove('error', 'success');
                });
                
                // Get values
                const title = titleInput ? titleInput.value.trim() : '';
                const description = descriptionInput ? descriptionInput.value.trim() : '';
                const priceStr = priceInput ? priceInput.value.trim() : '';
                const price = priceStr ? parseFloat(priceStr) : NaN;
                const location = locationInput ? locationInput.value.trim() : '';
                const country = countryInput ? countryInput.value : '';
                
                // Validation
                const errors = [];
                const errorFields = [];
                
                // Title validation
                if (!title) {
                    errors.push('Please enter a title');
                    errorFields.push('title');
                    if (titleInput) titleInput.classList.add('error');
                } else if (title.length < 5) {
                    errors.push('Title must be at least 5 characters');
                    errorFields.push('title');
                    if (titleInput) titleInput.classList.add('error');
                } else if (title.length > 100) {
                    errors.push('Title cannot exceed 100 characters');
                    errorFields.push('title');
                    if (titleInput) titleInput.classList.add('error');
                } else {
                    if (titleInput) titleInput.classList.add('success');
                }
                
                // Description validation
                if (!description) {
                    errors.push('Please enter a description');
                    errorFields.push('description');
                    if (descriptionInput) descriptionInput.classList.add('error');
                } else if (description.length < 20) {
                    errors.push('Description must be at least 20 characters');
                    errorFields.push('description');
                    if (descriptionInput) descriptionInput.classList.add('error');
                } else if (description.length > 2000) {
                    errors.push('Description cannot exceed 2000 characters');
                    errorFields.push('description');
                    if (descriptionInput) descriptionInput.classList.add('error');
                } else {
                    if (descriptionInput) descriptionInput.classList.add('success');
                }
                
                // Price validation
                if (!priceStr) {
                    errors.push('Please enter a price');
                    errorFields.push('price');
                    if (priceInput) priceInput.classList.add('error');
                } else if (isNaN(price)) {
                    errors.push('Price must be a valid number');
                    errorFields.push('price');
                    if (priceInput) priceInput.classList.add('error');
                } else if (price < 50) {
                    errors.push('Price must be at least $50');
                    errorFields.push('price');
                    if (priceInput) priceInput.classList.add('error');
                } else if (price > 10000) {
                    errors.push('Price cannot exceed $10,000');
                    errorFields.push('price');
                    if (priceInput) priceInput.classList.add('error');
                } else {
                    if (priceInput) priceInput.classList.add('success');
                }
                
                // Location validation
                if (!location) {
                    errors.push('Please enter a location');
                    errorFields.push('location');
                    if (locationInput) locationInput.classList.add('error');
                } else if (location.length < 4) {
                    errors.push('Location must be at least 4 characters');
                    errorFields.push('location');
                    if (locationInput) locationInput.classList.add('error');
                } else if (location.length > 200) {
                    errors.push('Location cannot exceed 200 characters');
                    errorFields.push('location');
                    if (locationInput) locationInput.classList.add('error');
                } else {
                    if (locationInput) locationInput.classList.add('success');
                }
                
                // Country validation
                if (!country) {
                    errors.push('Please select a country');
                    errorFields.push('country');
                    if (countryInput) countryInput.classList.add('error');
                } else if (country.length < 4) {
                    errors.push('Country must be at least 4 characters');
                    errorFields.push('country');
                    if (countryInput) countryInput.classList.add('error');
                } else if (country.length > 100) {
                    errors.push('Country cannot exceed 100 characters');
                    errorFields.push('country');
                    if (countryInput) countryInput.classList.add('error');
                } else {
                    if (countryInput) countryInput.classList.add('success');
                }
                
                // Media validation
                const existingItems = document.querySelectorAll('.existing-media');
                const newItems = document.querySelectorAll('.new-media-item');
                const totalNonDeletedItems = (existingItems.length - mediaToDelete.length) + newItems.length;
                
                if (totalNonDeletedItems === 0) {
                    errors.push('At least one media file is required');
                }
                
                // If there are errors, show them and prevent submission
                if (errors.length > 0) {
                    if (clientAlert) {
                        // Create Airbnb pink alert with white X
                        clientAlert.innerHTML = `
                            <div class="airbnb-alert">
                                <button type="button" class="close-btn" id="closeErrorBtn" aria-label="Close">×</button>
                                <div class="alert-title">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                    Please fix the following ${errors.length === 1 ? 'error' : 'errors'}:
                                </div>
                                <div class="alert-body">
                                    <ul>
                                        ${errors.map(error => `<li>${error}</li>`).join('')}
                                    </ul>
                                </div>
                            </div>
                        `;
                        clientAlert.style.display = 'block';
                        
                        // Add event listener to close button
                        document.getElementById('closeErrorBtn').addEventListener('click', function() {
                            // Hard refresh the page
                            window.location.reload(true);
                        });
                    }
                    
                    // Focus on first error field
                    if (errorFields.length > 0) {
                        const firstErrorField = document.getElementById(errorFields[0]);
                        if (firstErrorField) {
                            firstErrorField.focus();
                        }
                    }
                    
                    return false;
                }
                
                // If no errors, submit the form
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Saving Changes...';
                }
                
                // Submit the form
                editForm.submit();
            });
        }
    </script>
</body>
</html>