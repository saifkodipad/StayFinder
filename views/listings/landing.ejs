        </div>
        <div class="stat-card">
          <div class="stat-number">4.9</div>
          <h4 class="font-bold text-gray-900">Guest Rating</h4>
          <p class="text-sm text-gray-500 mt-2">Average guest satisfaction score</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Seasonal Collections Section -->
  <section class="py-12 md:py-20 px-4 lg:px-12 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12 md:mb-16">
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-gray-900 mb-4">Seasonal Collections</h2>
        <p class="text-gray-600 max-w-2xl mx-auto text-base md:text-lg">Discover curated stays perfect for every season. Expertly selected based on climate, activities, and local experiences.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        <!-- Summer Collection -->
        <a href="/listings?season=summer" class="season-card group no-underline">
          <div class="absolute inset-0">
            <img src="https://images.unsplash.com/photo-1519046904884-53103b34b206?auto=format&fit=crop&w=800&q=80" 
                 alt="Summer destinations with beach and coastal properties" 
                 class="w-full h-full object-cover">
          </div>
          <div class="season-card-content">
            <div class="season-indicator bg-orange-500">SUMMER</div>
            <h3 class="text-xl md:text-2xl font-bold mb-2">Coastal Escapes</h3>
            <p class="text-sm opacity-90">Beachfront properties with ocean access</p>
          </div>
        </a>
        
        <!-- Winter Collection -->
        <a href="/listings?season=winter" class="season-card group no-underline">
          <div class="absolute inset-0">
            <img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=800&q=80" 
                 alt="Winter mountain cabins and ski resorts" 
                 class="w-full h-full object-cover">
          </div>
          <div class="season-card-content">
            <div class="season-indicator bg-blue-500">WINTER</div>
            <h3 class="text-xl md:text-2xl font-bold mb-2">Mountain Retreats</h3>
            <p class="text-sm opacity-90">Ski-in properties with fireplaces</p>
          </div>
        </a>
        
        <!-- Spring Collection -->
        <a href="/listings?season=spring" class="season-card group no-underline">
          <div class="absolute inset-0">
            <img src="https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&fit=crop&w=800&q=80" 
                 alt="Spring countryside estates and gardens" 
