          </div>
          <div class="season-card-content">
            <div class="season-indicator bg-green-500">SPRING</div>
            <h3 class="text-xl md:text-2xl font-bold mb-2">Countryside Estates</h3>
            <p class="text-sm opacity-90">Properties with blooming gardens</p>
          </div>
        </a>
        
        <!-- Autumn Collection -->
        <a href="/listings?season=autumn" class="season-card group no-underline">
          <div class="absolute inset-0">
            <img src="https://images.unsplash.com/photo-1506197603052-3cc9c3a201bd?auto=format&fit=crop&w=800&q=80" 
                 alt="Autumn forest cabins and countryside homes" 
