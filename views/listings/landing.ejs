                <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Right Column: Map -->
      <div class="lg:col-span-7">
      
          <div id="map" class="h-64 sm:h-80 md:h-96 lg:h-[500px] w-full"></div>
          
          <!-- SINGLE ZOOM CONTROL BUTTON -->
          <div class="single-zoom-control">
            <button id="zoomInBtn" class="zoom-control-button zoom-in" title="Zoom In">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
            </button>
            <button id="zoomOutBtn" class="zoom-control-button zoom-out" title="Zoom Out">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/>
              </svg>
            </button>
          </div>
          
          <!-- Map Attribution -->
          <div class="absolute bottom-2 left-2 z-10  backdrop-blur-sm px-3 py-1 rounded-full text-xs text-gray-600">
            © <a href="https://www.openstreetmap.org/copyright" target="_blank" class="text-brand hover:underline">OpenStreetMap</a> contributors
          </div>
        </div>
        
        <!-- Map Stats -->
        
    </div>
  </div>
</section>

  <!-- Email Contact Form Section -->
  <section id="contact" class="py-12 md:py-20 px-4 lg:px-12 bg-white border-t border-gray-100">
    <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12 md:mb-16">
            <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-gray-900 mb-4">Contact Us</h2>
            <p class="text-gray-600 max-w-2xl mx-auto text-base md:text-lg">Have questions or need assistance? Send us a message and we'll get back to you promptly.</p>
        </div>
        
        <div class="email-form-container">
            <!-- Client-side validation alert -->
            <div id="clientAlert" style="display: none;"></div>
            
            <form id="email-form" class="space-y-6 md:space-y-8">
                <!-- Email Input -->
                <div>
                    <label for="sender-email" class="block text-sm font-medium text-gray-700 mb-3 required">
                        Your Email Address
                    </label>
                    <input 
                        type="email" 
                        id="sender-email" 
                        name="senderEmail"
                        placeholder="Enter your email address"
                        class="form-input form-control"
                        maxlength="100"
                    >
                    <div class="character-count" id="emailCount">0/100 characters</div>
                </div>
                
                <!-- Subject Input -->
                <div>
                    <label for="email-subject" class="block text-sm font-medium text-gray-700 mb-3 required">
                        Subject
                    </label>
                    <input 
                        type="text" 
                        id="email-subject" 
                        name="emailSubject"
                        placeholder="What is this regarding?"
                        class="form-input form-control"
                        maxlength="200"
                    >
                    <div class="character-count" id="subjectCount">0/200 characters</div>
                </div>
                
                <!-- Message Input -->
                <div>
                    <label for="email-message" class="block text-sm font-medium text-gray-700 mb-3 required">
                        Your Message
                    </label>
                    <textarea 
                        id="email-message" 
                        name="emailMessage"
                        rows="4"
                        placeholder="Please provide details about your inquiry..."
                        class="form-input resize-none form-control"
                        maxlength="2000"
                    ></textarea>
                    <div class="character-count" id="messageCount">0/2000 characters</div>
                </div>
                
                <!-- Submit Button -->
                <div class="pt-4 md:pt-6 flex justify-center">
                    <button 
                        type="submit"
                        id="send-email-btn"
                        class="send-btn"
                    >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                        </svg>
                        <span id="send-btn-text">Send Message</span>
                        <span id="send-spinner" class="hidden">
                            <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                        </span>
                    </button>
                </div>
            </form>
            
            <!-- Success/Error Message -->
            <div id="message-feedback" class="hidden mt-4 md:mt-6 p-4 rounded-lg text-center"></div>
        </div>
    </div>
  </section>

  

</div>

<!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<!-- Leaflet JS for Map -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
  // Global map variable
  let map;

  // Mobile menu toggle
  document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    
    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', function() {
        mobileMenu.classList.toggle('hidden');
      });
    }

    // Initialize Swiper
    const swiper = new Swiper('.reviewSwiper', {
      slidesPerView: 1,
      spaceBetween: 20,
      loop: true,
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      breakpoints: {
        640: {
          slidesPerView: 1,
          spaceBetween: 20,
        },
        768: {
          slidesPerView: 2,
          spaceBetween: 30,
        },
        1024: {
          slidesPerView: 3,
          spaceBetween: 30,
        },
      },
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },
    });

    // Initialize Map with transparent background
    map = L.map('map', {
      center: [20, 0],
      zoom: 2,
      zoomControl: false, // Disable default zoom control
      attributionControl: false // We'll add our own attribution
    });

    // Add semi-transparent OpenStreetMap tiles
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: false,
      maxZoom: 19,
      opacity: 0.7 // Make tiles semi-transparent
    }).addTo(map);

    // Add custom attribution
    L.control.attribution({
      position: 'bottomleft'
    }).addTo(map).addAttribution('© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors');

    // Sample property locations
    const propertyLocations = [
      { lat: 40.7128, lng: -74.0060, title: "New York Luxury Loft", price: "$350/night" },
      { lat: 48.8566, lng: 2.3522, title: "Parisian Apartment", price: "$280/night" },
      { lat: 51.5074, lng: -0.1278, title: "London Townhouse", price: "$320/night" },
      { lat: 35.6762, lng: 139.6503, title: "Tokyo Modern Suite", price: "$250/night" },
      { lat: -33.8688, lng: 151.2093, title: "Sydney Beach House", price: "$400/night" },
      { lat: 43.6532, lng: -79.3832, title: "Toronto Penthouse", price: "$300/night" },
      { lat: 19.4326, lng: -99.1332, title: "Mexico City Villa", price: "$220/night" },
      { lat: -23.5505, lng: -46.6333, title: "São Paulo Luxury", price: "$190/night" },
      { lat: 55.7558, lng: 37.6173, title: "Moscow Residence", price: "$270/night" },
      { lat: 28.6139, lng: 77.2090, title: "Delhi Heritage Home", price: "$180/night" },
      { lat: 1.3521, lng: 103.8198, title: "Singapore High-rise", price: "$350/night" },
      { lat: 25.2048, lng: 55.2708, title: "Dubai Sky Villa", price: "$500/night" }
    ];

    // Add custom marker icon
    const customIcon = L.divIcon({
      className: 'custom-marker',
      html: `<div style="background-color: #FF385C; width: 20px; height: 20px; border-radius: 50%; border: 3px solid white; box-shadow: 0 2px 6px rgba(0,0,0,0.3);"></div>`,
      iconSize: [26, 26],
      iconAnchor: [13, 13]
    });

    // Add markers for each property location
    propertyLocations.forEach(location => {
      const marker = L.marker([location.lat, location.lng], { icon: customIcon }).addTo(map);
      
      // Create popup content
      const popupContent = `
        <div style="padding: 10px;">
          <h3 style="margin: 0 0 8px 0; color: #FF385C; font-weight: bold;">${location.title}</h3>
          <p style="margin: 0 0 5px 0; font-size: 14px;">📍 ${location.lat.toFixed(2)}, ${location.lng.toFixed(2)}</p>
          <p style="margin: 0; font-size: 16px; font-weight: bold;">${location.price}</p>
          <button onclick="window.location.href='/listings'" style="margin-top: 10px; background: #FF385C; color: white; border: none; padding: 8px 16px; border-radius: 8px; cursor: pointer; font-size: 14px;">
            View Details
          </button>
        </div>
      `;
      
      marker.bindPopup(popupContent);
    });

    // Add single zoom control buttons event listeners
    const zoomInBtn = document.getElementById('zoomInBtn');
    const zoomOutBtn = document.getElementById('zoomOutBtn');
    
    if (zoomInBtn) {
      zoomInBtn.addEventListener('click', function() {
        map.zoomIn();
      });
    }
    
    if (zoomOutBtn) {
      zoomOutBtn.addEventListener('click', function() {
        map.zoomOut();
      });
    }

    // Add scale control
    L.control.scale({
      imperial: false,
      position: 'bottomright'
    }).addTo(map);
  });

  // FORM VALIDATION IMPLEMENTATION
  // Get form elements
  const emailForm = document.getElementById('email-form');
  const clientAlert = document.getElementById('clientAlert');
  const sendBtn = document.getElementById('send-email-btn');
  
  // Get all form inputs
  const emailInput = document.getElementById('sender-email');
  const subjectInput = document.getElementById('email-subject');
  const messageInput = document.getElementById('email-message');
  
  // Character counters
  const emailCount = document.getElementById('emailCount');
  const subjectCount = document.getElementById('subjectCount');
  const messageCount = document.getElementById('messageCount');
  
  // Character counter updates
  function updateCharacterCount(input, counter, maxLength) {
    const length = input.value.length;
    counter.textContent = `${length}/${maxLength} characters`;
    
    if (length > maxLength * 0.9) {
      counter.className = 'character-count near-limit';
    } else if (length > maxLength) {
      counter.className = 'character-count over-limit';
    } else {
      counter.className = 'character-count';
    }
  }
  
  // Initialize character counters
  if (emailInput) {
    emailInput.addEventListener('input', () => updateCharacterCount(emailInput, emailCount, 100));
    subjectInput.addEventListener('input', () => updateCharacterCount(subjectInput, subjectCount, 200));
    messageInput.addEventListener('input', () => updateCharacterCount(messageInput, messageCount, 2000));
  }
  
  // Remove validation styling when user starts typing
  function clearFieldStyling(input) {
    input.classList.remove('error', 'success');
    if (clientAlert && clientAlert.style.display === 'block') {
      clientAlert.style.display = 'none';
      clientAlert.innerHTML = '';
      clientAlert.className = '';
    }
  }
  
  // Add input listeners to clear styling
  if (emailInput && subjectInput && messageInput) {
    [emailInput, subjectInput, messageInput].forEach(input => {
      input.addEventListener('input', function() {
        clearFieldStyling(this);
      });
    });
  }
  
  // Function to force hard refresh
  function hardRefreshPage() {
    window.location.reload(true);
  }
  
  // Email Form Submission Handler
  if (emailForm) {
    emailForm.addEventListener('submit', async function(event) {
      event.preventDefault();
      
      // Clear previous client alert and field styling
      if (clientAlert) {
        clientAlert.style.display = 'none';
        clientAlert.innerHTML = '';
        clientAlert.className = '';
      }
      
      // Clear all field styling
      if (emailInput && subjectInput && messageInput) {
        [emailInput, subjectInput, messageInput].forEach(input => {
          input.classList.remove('error', 'success');
        });
      }
      
      // Get values
      const email = emailInput.value.trim();
      const subject = subjectInput.value.trim();
      const message = messageInput.value.trim();
      
      // Validation
      const errors = [];
      const errorFields = [];
      
      // Email validation
      if (!email) {
        errors.push('Please enter your email address');
        errorFields.push('sender-email');
        emailInput.classList.add('error');
      } else {
        // Basic email format validation
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
          errors.push('Please enter a valid email address');
          errorFields.push('sender-email');
          emailInput.classList.add('error');
        } else if (email.length > 100) {
          errors.push('Email cannot exceed 100 characters');
          errorFields.push('sender-email');
          emailInput.classList.add('error');
        } else {
          emailInput.classList.add('success');
        }
      }
      
      // Subject validation
      if (!subject) {
        errors.push('Please enter a subject');
        errorFields.push('email-subject');
        subjectInput.classList.add('error');
      } else if (subject.length < 5) {
        errors.push('Subject must be at least 5 characters');
        errorFields.push('email-subject');
        subjectInput.classList.add('error');
      } else if (subject.length > 200) {
        errors.push('Subject cannot exceed 200 characters');
        errorFields.push('email-subject');
        subjectInput.classList.add('error');
      } else {
        subjectInput.classList.add('success');
      }
      
      // Message validation
      if (!message) {
        errors.push('Please enter your message');
        errorFields.push('email-message');
        messageInput.classList.add('error');
      } else if (message.length < 10) {
        errors.push('Message must be at least 10 characters');
        errorFields.push('email-message');
        messageInput.classList.add('error');
      } else if (message.length > 2000) {
        errors.push('Message cannot exceed 2000 characters');
        errorFields.push('email-message');
        messageInput.classList.add('error');
      } else {
        messageInput.classList.add('success');
      }
      
      // If there are errors, show them and prevent submission
      if (errors.length > 0) {
        // Show errors in client alert
        if (clientAlert) {
          clientAlert.className = 'client-alert error';
          clientAlert.innerHTML = `
            <div class="alert-content">
              <strong>Please fix the following ${errors.length === 1 ? 'error' : 'errors'}:</strong>
              <ul class="mb-0 mt-2">
                ${errors.map(error => `<li>${error}</li>`).join('')}
              </ul>
            </div>
            <button type="button" class="btn-close" id="closeErrorBtn" aria-label="Close">×</button>
          `;
          clientAlert.style.display = 'block';
          
          // Add event listener to close button - HARD REFRESH PAGE
          document.getElementById('closeErrorBtn').addEventListener('click', function() {
            hardRefreshPage();
          });
        }
        
        // Focus on first error field
        if (errorFields.length > 0) {
          const firstErrorField = document.getElementById(errorFields[0]);
          if (firstErrorField) {
            firstErrorField.focus();
          }
        }
        
        return false;
      }
      
      // If no errors, proceed with form submission
      // Show loading state
      const sendBtnText = document.getElementById('send-btn-text');
      const sendSpinner = document.getElementById('send-spinner');
      
      if (sendBtn && sendBtnText && sendSpinner) {
        sendBtn.disabled = true;
        sendBtnText.textContent = 'Sending...';
        sendSpinner.classList.remove('hidden');
      }
      
      try {
        // Prepare form data
        const formData = {
          senderEmail: email,
          emailSubject: subject,
          emailMessage: message
        };
        
        // Send to your backend API endpoint
        const response = await fetch('/api/send-email', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(formData)
        });
        
        const result = await response.json();
        
        if (response.ok && result.success) {
          // Success - show success message
          if (clientAlert) {
            clientAlert.className = 'client-alert success';
            clientAlert.innerHTML = `
              <div class="alert-content">
                <strong>Success!</strong>
                <p>${result.message || 'Your message has been sent successfully! We will respond within 24 hours.'}</p>
              </div>
              <button type="button" class="btn-close" id="closeSuccessBtn" aria-label="Close">×</button>
            `;
            clientAlert.style.display = 'block';
            
            // Reset form
            emailForm.reset();
            emailCount.textContent = '0/100 characters';
            subjectCount.textContent = '0/200 characters';
            messageCount.textContent = '0/2000 characters';
            
            // Add event listener to close success button - HARD REFRESH PAGE
            document.getElementById('closeSuccessBtn').addEventListener('click', function() {
              hardRefreshPage();
            });
            
            // Clear field styling
            if (emailInput && subjectInput && messageInput) {
              [emailInput, subjectInput, messageInput].forEach(input => {
                input.classList.remove('success');
              });
            }
          }
        } else {
          // Error from server
          throw new Error(result.error || 'Failed to send message');
        }
        
      } catch (error) {
        console.error('Error:', error);
        
        // Show error in client alert
        if (clientAlert) {
          clientAlert.className = 'client-alert error';
          clientAlert.innerHTML = `
            <div class="alert-content">
              <strong>Error!</strong>
              <p>${error.message || 'Failed to send message. Please try again or contact support@stayfinder.com'}</p>
            </div>
            <button type="button" class="btn-close" id="closeErrorBtn2" aria-label="Close">×</button>
          `;
          clientAlert.style.display = 'block';
          
          // Add event listener to close button - HARD REFRESH PAGE
          document.getElementById('closeErrorBtn2').addEventListener('click', function() {
            hardRefreshPage();
          });
        }
      } finally {
        // Reset button state
        if (sendBtn && sendBtnText && sendSpinner) {
          sendBtn.disabled = false;
          sendBtnText.textContent = 'Send Message';
          sendSpinner.classList.add('hidden');
        }
      }
    });
  }

  // Smooth scroll for navigation
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const targetId = this.getAttribute('href');
      if (targetId === '#') return;
      
      const targetElement = document.querySelector(targetId);
      if (targetElement) {
        targetElement.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });
</script>
</body>
</html>