          </div>
          <div class="season-card-content">
            <div class="season-indicator bg-amber-600">AUTUMN</div>
            <h3 class="text-xl md:text-2xl font-bold mb-2">Forest Hideaways</h3>
            <p class="text-sm opacity-90">Cabins with seasonal foliage views</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Enhanced Customer Reviews Section -->
