        </a>
        <a href="/listings/new" class="px-8 md:px-10 py-3 md:py-4 bg-white border-2 border-gray-900 text-black rounded-full font-bold hover:bg-gray-50 transition no-underline text-center">
          Host Your Space
        </a>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-8 md:py-12 bg-white border-t border-gray-100">
