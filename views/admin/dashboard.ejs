<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | StayFinder</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #3a86ff;
            --primary-dark: #2667cc;
            --secondary: #8338ec;
            --success: #06d6a0;
            --warning: #ffd166;
            --danger: #ef476f;
            --dark: #1a1a2e;
            --light: #f8f9fa;
            --gray: #6c757d;
            --gray-light: #e9ecef;
            --border-radius: 12px;
            --box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
            --transition: all 0.3s ease;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f5f7fb;
            color: #333;
            line-height: 1.6;
        }
        
        /* Main Content */
        .main-content {
            width: 100%;
            padding: 0;
        }
        
        /* Topbar */
        .topbar {
            background-color: white;
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.05);
            width: 100%;
            border-radius: 0 0 var(--border-radius) var(--border-radius);
            margin-bottom: 30px;
        }
        
        .page-title h1 {
            font-size: 1.8rem;
            font-weight: 600;
            color: var(--dark);
            margin-bottom: 5px;
        }
        
        .page-title p {
            color: var(--gray);
            font-size: 0.9rem;
        }
        
        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .user-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background-color: #15202B;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 1.2rem;
        }
        
        .user-details h4 {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 3px;
        }
        
        .user-details p {
            font-size: 0.8rem;
            color: var(--gray);
        }
        
        /* Content Container */
        .content-container {
            padding: 0 40px 40px;
            width: 100%;
        }
        
        /* Stats Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
            margin-bottom: 30px;
            width: 100%;
        }
        
        .stat-card {
            background-color: white;
            border-radius: var(--border-radius);
            padding: 25px;
            box-shadow: var(--box-shadow);
            transition: var(--transition);
            border-left: 5px solid var(--primary);
        }
        
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        }
        
        .stat-card.users {
            border-left-color: var(--primary);
        }
        
        .stat-card.listings {
            border-left-color: var(--success);
        }
        
        .stat-card.admins {
            border-left-color: var(--warning);
        }
        
        .stat-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }
        
        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: white;
        }
        
        .stat-card.users .stat-icon {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        }
        
        .stat-card.listings .stat-icon {
            background: linear-gradient(135deg, var(--success), #05b185);
        }
        
        .stat-card.admins .stat-icon {
            background: linear-gradient(135deg, var(--warning), #e6b850);
        }
        
        .stat-content h3 {
            font-size: 2.2rem;
            font-weight: 700;
            margin-bottom: 5px;
        }
        
        .stat-content p {
            color: var(--gray);
            font-size: 0.95rem;
        }
        
        /* Quick Actions */
        .quick-actions-card {
            background-color: white;
            border-radius: var(--border-radius);
            padding: 25px;
            box-shadow: var(--box-shadow);
            margin-bottom: 30px;
            width: 100%;
        }
        
        .card-title {
            font-size: 1.4rem;
            font-weight: 600;
            margin-bottom: 20px;
            color: var(--dark);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .card-title i {
            color: var(--primary);
        }
        
        .actions-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px;
        }
        
        .action-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 18px 20px;
            background-color: var(--light);
            border: 2px solid transparent;
            border-radius: 10px;
            text-decoration: none;
            color: var(--dark);
            font-weight: 500;
            transition: var(--transition);
        }
        
        .action-btn:hover {
            background-color: white;
            border-color: var(--primary);
            transform: translateY(-3px);
        }
        
        .action-btn i {
            font-size: 1.2rem;
            color: var(--primary);
        }
        
        /* Tables */
        .section-card {
            background-color: white;
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
            margin-bottom: 30px;
            overflow: hidden;
            width: 100%;
        }
        
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 25px;
            border-bottom: 1px solid var(--gray-light);
        }
        
        .section-header h3 {
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--dark);
        }
        
        .view-all {
            color: var(--primary);
            text-decoration: none;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 5px;
            transition: var(--transition);
        }
        
        .view-all:hover {
            gap: 8px;
        }
        
        .table-container {
            padding: 0;
            overflow-x: auto;
            width: 100%;
        }
        
        .data-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 0;
        }
        
        .data-table thead {
            background-color: #f8fafc;
        }
        
        .data-table th {
            padding: 18px 20px;
            text-align: left;
            font-weight: 600;
            color: var(--dark);
            border-bottom: 1px solid var(--gray-light);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }
        
        .data-table td {
            padding: 18px 20px;
            border-bottom: 1px solid var(--gray-light);
            vertical-align: middle;
        }
        
        .data-table tbody tr {
            transition: var(--transition);
        }
        
        .data-table tbody tr:hover {
            background-color: #f8fafc;
        }
        
        .user-cell {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .user-avatar-sm {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #00BFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
        }
        
        .user-info-sm h4 {
            font-size: 0.95rem;
            font-weight: 600;
            margin-bottom: 3px;
        }
        
        .user-info-sm p {
            font-size: 0.8rem;
            color: var(--gray);
        }
        
        .badge {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 500;
        }
        
        .badge-admin {
            background-color: rgba(255, 209, 102, 0.2);
            color: #b0890b;
        }
        
        .badge-user {
            background-color: rgba(108, 117, 125, 0.15);
            color: var(--gray);
        }
        
        .action-buttons {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        
        .btn-icon {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            font-size: 0.9rem;
        }
        
        .btn-icon.view {
            background-color: rgba(58, 134, 255, 0.1);
            color: var(--primary);
        }
        
        .btn-icon.view:hover {
            background-color: var(--primary);
            color: white;
        }
        
        .btn-icon.edit {
            background-color: rgba(6, 214, 160, 0.1);
            color: var(--success);
        }
        
        .btn-icon.edit:hover {
            background-color: var(--success);
            color: white;
        }
        
        .btn-icon.delete {
            background-color: rgba(239, 71, 111, 0.1);
            color: var(--danger);
        }
        
        .btn-icon.delete:hover {
            background-color: var(--danger);
            color: white;
        }
        
        .btn-icon.admin {
            background-color: rgba(255, 209, 102, 0.2);
            color: #b0890b;
        }
        
        .btn-icon.admin:hover {
            background-color: #ffd166;
            color: #333;
        }
        
        .empty-state {
            padding: 50px 20px;
            text-align: center;
            color: var(--gray);
        }
        
        .empty-state i {
            font-size: 3rem;
            margin-bottom: 15px;
            opacity: 0.5;
        }
        
        /* Alerts */
        .alert-container {
            width: 100%;
            padding: 0 40px;
            margin: 20px 0 30px;
        }
        
        .alert {
            padding: 16px 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            animation: slideIn 0.3s ease;
        }
        
        @keyframes slideIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .alert-success {
            background-color: rgba(6, 214, 160, 0.1);
            border-left: 4px solid var(--success);
            color: #036d52;
        }
        
        .alert-danger {
            background-color: rgba(239, 71, 111, 0.1);
            border-left: 4px solid var(--danger);
            color: #a61e3c;
        }
        
        .close-alert {
            background: transparent;
            border: none;
            font-size: 1.2rem;
            color: inherit;
            opacity: 0.7;
            cursor: pointer;
            transition: var(--transition);
        }
        
        .close-alert:hover {
            opacity: 1;
        }
        
        /* Responsive */
        @media (max-width: 930px) {
            .topbar {
                flex-direction: column;
                align-items: flex-start;
                padding: 20px;
                gap: 15px;
            }
            
            .user-info {
                align-self: stretch;
                justify-content: space-between;
            }
            
            .alert-container {
                padding: 0 20px;
            }
            
            .content-container {
                padding: 0 20px 30px;
            }
            
            .stats-grid {
                grid-template-columns: 1fr;
                gap: 15px;
            }
            
            .actions-grid {
                grid-template-columns: 1fr;
            }
            
            .data-table {
                font-size: 0.9rem;
            }
            
            .data-table th,
            .data-table td {
                padding: 12px 10px;
            }
        }
        
        @media (max-width: 768px) {
            .topbar {
                margin-bottom: 20px;
            }
            
            .section-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
                padding: 15px;
            }
            
            .section-header h3 {
                font-size: 1.1rem;
            }
            
            .card-title {
                font-size: 1.2rem;
            }
            
            .stat-card {
                padding: 20px;
            }
            
            .stat-content h3 {
                font-size: 1.8rem;
            }
            
            .stat-icon {
                width: 50px;
                height: 50px;
                font-size: 1.2rem;
            }
            
            .data-table {
                display: block;
            }
            
            .data-table thead {
                display: none;
            }
            
            .data-table tbody tr {
                display: block;
                margin-bottom: 15px;
                border: 1px solid var(--gray-light);
                border-radius: 8px;
                padding: 10px;
            }
            
            .data-table tbody tr:hover {
                background-color: transparent;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            }
            
            .data-table td {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 10px 5px;
                border-bottom: 1px dashed var(--gray-light);
            }
            
            .data-table td:last-child {
                border-bottom: none;
            }
            
            .data-table td::before {
                content: attr(data-label);
                font-weight: 600;
                color: var(--dark);
                margin-right: 10px;
                flex: 1;
            }
            
            .data-table td .action-buttons {
                justify-content: flex-end;
                flex: 2;
            }
            
            .user-cell {
                justify-content: space-between;
                width: 100%;
            }
        }
        
        @media (max-width: 480px) {
            .topbar {
                padding: 15px;
            }
            
            .page-title h1 {
                font-size: 1.5rem;
            }
            
            .user-avatar {
                width: 40px;
                height: 40px;
                font-size: 1rem;
            }
            
            .user-details h4 {
                font-size: 0.9rem;
            }
            
            .alert-container {
                padding: 0 15px;
            }
            
            .content-container {
                padding: 0 10px 20px;
            }
            
            .quick-actions-card {
                padding: 20px;
            }
            
            .action-btn {
                padding: 15px;
            }
        }
    </style>
</head>
<body>
    <!-- Topbar -->
    <header class="topbar">
        <div class="page-title">
            <h1>Admin Dashboard</h1>
            <p>Manage your StayFinder platform</p>
        </div>
        
        <div class="user-info">
            <div class="user-avatar">
                <%= currentUser.firstName.charAt(0).toUpperCase() %><%= currentUser.lastName.charAt(0).toUpperCase() %>
            </div>
            <div class="user-details">
                <h4><%= currentUser.firstName %> <%= currentUser.lastName %></h4>
                <p>Last login: <%= currentUser.lastLogin ? new Date(currentUser.lastLogin).toLocaleString() : 'Never' %></p>
            </div>
        </div>
    </header>
    
    <!-- Flash Messages -->
    <!-- <div class="alert-container">
        <% if(success && success.length > 0) { %>
            <div class="alert alert-success">
                <span><%= success %></span>
                <button class="close-alert">&times;</button>
            </div>
        <% } %>
        
        <% if(error && error.length > 0) { %>
            <div class="alert alert-danger">
                <span><%= error %></span>
                <button class="close-alert">&times;</button>
            </div>
        <% } %>
    </div> -->
    
    <!-- Main Content -->
    <main class="main-content">
        <div class="content-container">
            <!-- Stats Cards -->
            <div class="stats-grid">
                <div class="stat-card users">
                    <div class="stat-header">
                        <div class="stat-content">
                            <h3><%= allUsers.length %></h3>
                            <p>Total Users</p>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                </div>
                
                <div class="stat-card listings">
                    <div class="stat-header">
                        <div class="stat-content">
                            <h3><%= allListings.length %></h3>
                            <p>Total Listings</p>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-home"></i>
                        </div>
                    </div>
                </div>
                
                <div class="stat-card admins">
                    <div class="stat-header">
                        <div class="stat-content">
                            <h3><%= allUsers.filter(u => u.role === 'admin').length %></h3>
                            <p>Administrators</p>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-crown"></i>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Quick Actions -->
            <div class="quick-actions-card">
                <h3 class="card-title">
                    <i class="fas fa-bolt"></i>
                    Quick Actions
                </h3>
                
                <div class="actions-grid">
                    <a href="/admin/manageUsers" class="action-btn">
                        <i class="fas fa-user-cog"></i>
                        <span>Manage Users</span>
                    </a>
                    
                    <a href="/listings" class="action-btn">
                        <i class="fas fa-search"></i>
                        <span>Browse Listings</span>
                    </a>
                    
                    <a href="/listings/new" class="action-btn">
                        <i class="fas fa-plus"></i>
                        <span>Create Listing</span>
                    </a>
                   
                </div>
            </div>
            
            <!-- Recent Users -->
            <div class="section-card">
                <div class="section-header">
                    <h3>Recent Users</h3>
                    <a href="/admin/users" class="view-all">
                        View all
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
                
                <div class="table-container">
                    <% if (allUsers && allUsers.length > 0) { %>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Joined</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% allUsers.slice(0, 5).forEach(user => { %>
                                    <tr>
                                        <td data-label="User">
                                            <div class="user-cell">
                                                <div class="user-avatar-sm">
                                                    <%= user.firstName ? user.firstName.charAt(0).toUpperCase() : user.username.charAt(0).toUpperCase() %>
                                                </div>
                                                <div class="user-info-sm">
                                                    <h4><%= user.username %></h4>
                                                    <p><%= user.firstName %> <%= user.lastName %></p>
                                                </div>
                                            </div>
                                        </td>
                                        <td data-label="Email"><%= user.email %></td>
                                        <td data-label="Role">
                                            <% if (user.role === 'admin') { %>
                                                <span class="badge badge-admin">Admin</span>
                                            <% } else { %>
                                                <span class="badge badge-user">User</span>
                                            <% } %>
                                        </td>
                                        <td data-label="Joined"><%= user.createdAt.toLocaleDateString() %></td>
                                        <td data-label="Actions">
                                            <div class="action-buttons">
                                                <% if (currentUser._id.toString() !== user._id.toString()) { %>
                                                    <% if (user.role !== 'admin') { %>
                                                        <form action="/admin/users/<%= user._id %>/make-admin" method="POST" class="d-inline">
                                                            <button type="submit" onclick="return confirm('Make this user an admin?')" 
                                                                class="btn-icon admin" title="Make Admin">
                                                                <i class="fas fa-crown"></i>
                                                            </button>
                                                        </form>
                                                    <% } %>
                                                    <form action="/admin/users/<%= user._id %>?_method=DELETE" method="POST" class="d-inline">
                                                        <button type="submit" onclick="return confirm('Delete this user?')" 
                                                            class="btn-icon delete" title="Delete User">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                <% } else { %>
                                                    <span class="text-muted" style="font-size: 0.85rem;">Current User</span>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div class="empty-state">
                            <i class="fas fa-users"></i>
                            <p>No users found</p>
                        </div>
                    <% } %>
                </div>
            </div>
            
            <!-- Recent Listings -->
            <div class="section-card">
                <div class="section-header">
                    <h3>Recent Listings</h3>
                    <a href="/listings" class="view-all">
                        View all
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
                
                <div class="table-container">
                    <% if (allListings && allListings.length > 0) { %>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Location</th>
                                    <th>Price</th>
                                    <th>Owner</th>
                                    <th>Created</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% allListings.slice(0, 5).forEach(listing => { %>
                                    <tr>
                                        <td data-label="Title"><%= listing.title %></td>
                                        <td data-label="Location"><%= listing.location || 'Not specified' %></td>
                                        <td data-label="Price">$<%= listing.price ? listing.price.toLocaleString('en-US') : '0' %></td>
                                        <td data-label="Owner">
                                            <% if (listing.host && listing.host.username) { %>
                                                <%= listing.host.username %>
                                            <% } else if (listing.host && listing.host.email) { %>
                                                <%= listing.host.email.split('@')[0] %>
                                            <% } else { %>
                                                <span class="text-muted">Unknown</span>
                                            <% } %>
                                        </td>
                                        <td data-label="Created"><%= listing.createdAt.toLocaleDateString() %></td>
                                        <td data-label="Actions">
                                            <div class="action-buttons">
                                                <a href="/listings/<%= listing._id %>" class="btn-icon view" title="View">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a href="/listings/<%= listing._id %>/edit" class="btn-icon edit" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <form action="/admin/listings/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline">
                                                    <button type="submit" onclick="return confirm('Delete this listing?')" 
                                                        class="btn-icon delete" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div class="empty-state">
                            <i class="fas fa-home"></i>
                            <p>No listings found</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>
    
    <script>
        // Close alert functionality
        document.addEventListener('DOMContentLoaded', function() {
            const closeButtons = document.querySelectorAll('.close-alert');
            closeButtons.forEach(button => {
                button.addEventListener('click', function() {
                    this.closest('.alert').style.display = 'none';
                });
            });
            
            // Auto-hide alerts after 5 seconds
            setTimeout(() => {
                document.querySelectorAll('.alert').forEach(alert => {
                    alert.style.opacity = '0';
                    alert.style.transition = 'opacity 0.5s ease';
                    setTimeout(() => {
                        alert.style.display = 'none';
                    }, 500);
                });
            }, 5000);
            
            // Make table responsive for mobile
            function makeTableResponsive() {
                if (window.innerWidth <= 768) {
                    // Add data-label attributes to table cells based on header text
                    const tables = document.querySelectorAll('.data-table');
                    tables.forEach(table => {
                        const headers = [];
                        const headerCells = table.querySelectorAll('thead th');
                        headerCells.forEach((header, index) => {
                            headers[index] = header.textContent.trim();
                        });
                        
                        const rows = table.querySelectorAll('tbody tr');
                        rows.forEach(row => {
                            const cells = row.querySelectorAll('td');
                            cells.forEach((cell, index) => {
                                if (headers[index]) {
                                    cell.setAttribute('data-label', headers[index]);
                                }
                            });
                        });
                    });
                }
            }
            
            // Run on load and resize
            makeTableResponsive();
            window.addEventListener('resize', makeTableResponsive);
        });
    </script>
</body>
</html>