<!-- views/admin/manageUsers.ejs -->
<div class="min-h-screen bg-gray-100">
  <!-- Admin Header with Back Button -->
  <div class="bg-primary text-white">
    <div class="container px-4 py-4">
      <div class="d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
          <a href="/admin/dashboard" class="btn btn-outline-light btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Back to Dashboard
          </a>
          <div>
            <h1 class="h3 mb-1">Manage Users</h1>
            <p class="mb-0 opacity-75">Search and manage all platform users</p>
          </div>
        </div>
        <div class="text-end">
          <div class="dropdown">
            <button class="btn btn-light btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
              <i class="fas fa-user-cog me-1"></i>Admin Actions
            </button>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/admin/dashboard"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item text-danger" href="/logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Flash Messages -->
  <% if(success && success.length > 0) { %>
    <div class="container mt-3">
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i><%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    </div>
  <% } %>
  
  <% if(error && error.length > 0) { %>
    <div class="container mt-3">
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i><%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    </div>
  <% } %>

  <!-- Main Content -->
  <div class="container py-4">
    
    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
      <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="text-muted mb-2">Total Users</h6>
                <h2 class="mb-0"><%= users.length %></h2>
                <small class="text-success"><i class="fas fa-arrow-up"></i> All time</small>
              </div>
              <div class="bg-primary bg-opacity-10 p-2 rounded-circle">
                <i class="fas fa-users fa-lg text-primary"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="text-muted mb-2">Admins</h6>
                <h2 class="mb-0"><%= users.filter(u => u.role === 'admin').length %></h2>
                <small class="text-warning"><i class="fas fa-crown"></i> Platform managers</small>
              </div>
              <div class="bg-warning bg-opacity-10 p-2 rounded-circle">
                <i class="fas fa-crown fa-lg text-warning"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="text-muted mb-2">Active Today</h6>
                <h2 class="mb-0">
                  <% 
                    const today = new Date();
                    let activeToday = 0;
                    users.forEach(u => {
                      if (u.lastLogin) {
                        const lastLogin = new Date(u.lastLogin);
                        if (lastLogin.toDateString() === today.toDateString()) {
                          activeToday++;
                        }
                      }
                    });
                  %>
                  <%= activeToday %>
                </h2>
                <small class="text-info"><i class="fas fa-clock"></i> Last 24 hours</small>
              </div>
              <div class="bg-info bg-opacity-10 p-2 rounded-circle">
                <i class="fas fa-user-check fa-lg text-info"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="text-muted mb-2">New Users</h6>
                <h2 class="mb-0">
                  <%
                    const last7Days = new Date();
                    last7Days.setDate(last7Days.getDate() - 7);
                    let newUsers = 0;
                    users.forEach(u => {
                      if (new Date(u.createdAt) > last7Days) {
                        newUsers++;
                      }
                    });
                  %>
                  <%= newUsers %>
                </h2>
                <small class="text-success"><i class="fas fa-user-plus"></i> Last 7 days</small>
              </div>
              <div class="bg-success bg-opacity-10 p-2 rounded-circle">
                <i class="fas fa-user-plus fa-lg text-success"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Search and Filter Bar -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-8">
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0">
                <i class="fas fa-search text-muted"></i>
              </span>
              <input 
                type="text" 
                id="userSearch" 
                class="form-control border-start-0" 
                placeholder="Search users by name, email, or username..."
                onkeyup="filterUsers()"
              >
              <button class="btn btn-outline-secondary" type="button" onclick="clearSearch()">
                <i class="fas fa-times"></i>
              </button>
            </div>
          </div>
          <div class="col-md-4">
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0">
                <i class="fas fa-filter text-muted"></i>
              </span>
              <select id="roleFilter" class="form-select border-start-0" onchange="filterUsers()">
                <option value="all">All Roles</option>
                <option value="admin">Admins Only</option>
                <option value="user">Users Only</option>
              </select>
            </div>
          </div>
        </div>
        
        <!-- Quick Stats -->
        <div class="row mt-3">
          <div class="col-12">
            <div class="d-flex flex-wrap gap-3">
              <span class="badge bg-primary">
                <i class="fas fa-users me-1"></i>Total: <%= users.length %>
              </span>
              <span class="badge bg-warning">
                <i class="fas fa-crown me-1"></i>Admins: <%= users.filter(u => u.role === 'admin').length %>
              </span>
              <span class="badge bg-success">
                <i class="fas fa-user me-1"></i>Regular: <%= users.filter(u => u.role === 'user').length %>
              </span>
              <span class="badge bg-info">
                <i class="fas fa-clock me-1"></i>Active Today: <%= activeToday %>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Admin Actions Card -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white border-0">
        <h5 class="mb-0"><i class="fas fa-tools me-2"></i>Admin Actions</h5>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-3 col-sm-6">
            <div class="text-center p-3 border rounded bg-light">
              <i class="fas fa-crown fa-2x text-warning mb-2"></i>
              <h6>Promote to Admin</h6>
              <p class="small text-muted mb-2">Grant admin privileges to trusted users</p>
              <span class="badge bg-warning">Elevate Role</span>
            </div>
          </div>
          <div class="col-md-3 col-sm-6">
            <div class="text-center p-3 border rounded bg-light">
              <i class="fas fa-user-shield fa-2x text-success mb-2"></i>
              <h6>Demote to User</h6>
              <p class="small text-muted mb-2">Remove admin privileges if needed</p>
              <span class="badge bg-success">Adjust Role</span>
            </div>
          </div>
          <div class="col-md-3 col-sm-6">
            <div class="text-center p-3 border rounded bg-light">
              <i class="fas fa-trash-alt fa-2x text-danger mb-2"></i>
              <h6>Delete User</h6>
              <p class="small text-muted mb-2">Remove user from platform</p>
              <span class="badge bg-danger">Permanent</span>
            </div>
          </div>
          <div class="col-md-3 col-sm-6">
            <div class="text-center p-3 border rounded bg-light">
              <i class="fas fa-eye fa-2x text-primary mb-2"></i>
              <h6>View Profile</h6>
              <p class="small text-muted mb-2">Check user details and activity</p>
              <span class="badge bg-primary">Inspect</span>
            </div>
          </div>
        </div>
        <div class="mt-3 alert alert-info">
          <i class="fas fa-info-circle me-2"></i>
          <strong>Note:</strong> You cannot delete or demote yourself. Admin actions are logged for security.
        </div>
      </div>
    </div>

    <!-- Users Grid -->
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
          <i class="fas fa-users me-2"></i>
          All Users <span class="badge bg-secondary"><%= users.length %></span>
        </h5>
        <button class="btn btn-sm btn-outline-primary" onclick="refreshUsers()">
          <i class="fas fa-sync-alt me-1"></i>Refresh
        </button>
      </div>
      <div class="card-body p-0">
        <% if (users && users.length > 0) { %>
          <div id="usersGrid" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 p-4">
            <% users.forEach(user => { %>
              <div class="col user-card" data-username="<%= user.username.toLowerCase() %>" 
                   data-email="<%= user.email.toLowerCase() %>" 
                   data-name="<%= (user.firstName + ' ' + user.lastName).toLowerCase() %>"
                   data-role="<%= user.role %>">
                <div class="card h-100 border shadow-sm-hover">
                  <div class="card-body">
                    <!-- User Header -->
                    <div class="d-flex align-items-start mb-3">
                      <div class="avatar-lg bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3">
                        <span class="text-primary fw-bold fs-4"><%= user.username.charAt(0).toUpperCase() %></span>
                      </div>
                      <div class="flex-grow-1">
                        <h6 class="card-title mb-1">
                          <%= user.firstName %> <%= user.lastName %>
                          <% if (user._id.toString() === currentUser._id.toString()) { %>
                            <span class="badge bg-info ms-2">You</span>
                          <% } %>
                        </h6>
                        <p class="text-muted small mb-1">
                          <i class="fas fa-at me-1"></i>@<%= user.username %>
                        </p>
                        <p class="text-muted small mb-0">
                          <i class="fas fa-envelope me-1"></i><%= user.email %>
                        </p>
                      </div>
                      <div class="dropdown">
                        <button class="btn btn-sm btn-link text-muted" type="button" data-bs-toggle="dropdown">
                          <i class="fas fa-ellipsis-v"></i>
                        </button>
                        <ul class="dropdown-menu">
                          <li>
                            <a class="dropdown-item" href="/users/<%= user._id %>/profile">
                              <i class="fas fa-eye me-2"></i>View Profile
                            </a>
                          </li>
                          <li><hr class="dropdown-divider"></li>
                          <% if (user._id.toString() !== currentUser._id.toString()) { %>
                            <% if (user.role !== 'admin') { %>
                              <li>
                                <form action="/admin/users/<%= user._id %>/make-admin" method="POST" class="d-inline w-100">
                                  <button type="submit" onclick="return confirm('Promote <%= user.username %> to admin?')" 
                                    class="dropdown-item text-warning">
                                    <i class="fas fa-crown me-2"></i>Make Admin
                                  </button>
                                </form>
                              </li>
                            <% } else { %>
                              <li>
                                <form action="/admin/users/<%= user._id %>/remove-admin" method="POST" class="d-inline w-100">
                                  <button type="submit" onclick="return confirm('Remove admin role from <%= user.username %>?')" 
                                    class="dropdown-item text-secondary">
                                    <i class="fas fa-user me-2"></i>Remove Admin
                                  </button>
                                </form>
                              </li>
                            <% } %>
                            <li>
                              <form action="/admin/users/<%= user._id %>?_method=DELETE" method="POST" class="d-inline w-100">
                                <button type="submit" onclick="return confirm('Permanently delete <%= user.username %>?')" 
                                  class="dropdown-item text-danger">
                                  <i class="fas fa-trash-alt me-2"></i>Delete User
                                </button>
                              </form>
                            </li>
                          <% } else { %>
                            <li><span class="dropdown-item text-muted"><i class="fas fa-info-circle me-2"></i>Current User</span></li>
                          <% } %>
                        </ul>
                      </div>
                    </div>

                    <!-- User Details -->
                    <div class="mb-3">
                      <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Role:</span>
                        <% if (user.role === 'admin') { %>
                          <span class="badge bg-warning">
                            <i class="fas fa-crown me-1"></i>Admin
                          </span>
                        <% } else { %>
                          <span class="badge bg-secondary">
                            <i class="fas fa-user me-1"></i>User
                          </span>
                        <% } %>
                      </div>
                      <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Member Since:</span>
                        <span class="small">
                          <%= user.createdAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                        </span>
                      </div>
                      <div class="d-flex justify-content-between">
                        <span class="text-muted small">Last Login:</span>
                        <span class="small">
                          <% if (user.lastLogin) { %>
                            <%= new Date(user.lastLogin).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                          <% } else { %>
                            <span class="text-muted">Never</span>
                          <% } %>
                        </span>
                      </div>
                    </div>

                    <!-- Phone Number -->
                    <% if (user.phone && user.phone.trim() !== '') { %>
                      <div class="border-top pt-3">
                        <p class="small mb-1">
                          <i class="fas fa-phone me-1"></i>
                          <%= user.phone %>
                        </p>
                      </div>
                    <% } %>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 mt-3">
                      <a href="/users/<%= user._id %>/profile" class="btn btn-outline-primary btn-sm flex-fill">
                        <i class="fas fa-eye me-1"></i>View
                      </a>
                      <% if (user._id.toString() !== currentUser._id.toString()) { %>
                        <% if (user.role !== 'admin') { %>
                          <form action="/admin/users/<%= user._id %>/make-admin" method="POST" class="flex-fill">
                            <button type="submit" onclick="return confirm('Make <%= user.username %> admin?')" 
                              class="btn btn-outline-warning btn-sm w-100">
                              <i class="fas fa-crown"></i>
                            </button>
                          </form>
                        <% } else { %>
                          <form action="/admin/users/<%= user._id %>/remove-admin" method="POST" class="flex-fill">
                            <button type="submit" onclick="return confirm('Remove admin role from <%= user.username %>?')" 
                              class="btn btn-outline-secondary btn-sm w-100">
                              <i class="fas fa-user"></i>
                            </button>
                          </form>
                        <% } %>
                        <form action="/admin/users/<%= user._id %>?_method=DELETE" method="POST" class="flex-fill">
                          <button type="submit" onclick="return confirm('Delete <%= user.username %> permanently?')" 
                            class="btn btn-outline-danger btn-sm w-100">
                            <i class="fas fa-trash-alt"></i>
                          </button>
                        </form>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-5">
            <i class="fas fa-users fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">No Users Found</h5>
            <p class="text-muted">There are no users registered on the platform yet.</p>
          </div>
        <% } %>
      </div>
    </div>

  </div>
</div>

<style>
  .avatar-lg {
    width: 50px;
    height: 50px;
  }
  
  .bg-primary {
    background-color: #0d6efd !important;
  }
  
  .shadow-sm-hover:hover {
    box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
    transition: box-shadow 0.3s ease;
  }
  
  .user-card {
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  
  .user-card.hidden {
    display: none;
  }
</style>

<script>
  // Search and filter functionality
  function filterUsers() {
    const searchTerm = document.getElementById('userSearch').value.toLowerCase();
    const roleFilter = document.getElementById('roleFilter').value;
    const userCards = document.querySelectorAll('.user-card');
    
    userCards.forEach(card => {
      const username = card.getAttribute('data-username');
      const email = card.getAttribute('data-email');
      const name = card.getAttribute('data-name');
      const role = card.getAttribute('data-role');
      
      const matchesSearch = !searchTerm || 
        username.includes(searchTerm) || 
        email.includes(searchTerm) || 
        name.includes(searchTerm);
      
      const matchesRole = roleFilter === 'all' || role === roleFilter;
      
      if (matchesSearch && matchesRole) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }
  
  function clearSearch() {
    document.getElementById('userSearch').value = '';
    document.getElementById('roleFilter').value = 'all';
    filterUsers();
  }
  
  function refreshUsers() {
    window.location.reload();
  }
  
  // Initialize
  document.addEventListener('DOMContentLoaded', function() {
    filterUsers();
  });
</script>