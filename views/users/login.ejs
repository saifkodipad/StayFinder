<!-- login.ejs -->
<div class="row justify-content-center align-items-center min-vh-100">
    <div class="col-md-5 col-lg-4">
        <!-- Login Heading above the card -->
        <h1 class="login-heading mb-4 fw-bold text-left">Login</h1>
        
        <div class="card login-card border-0 shadow-lg">
            <div class="card-body p-4">
                <!-- Single alert container for client-side validation -->
                <div id="clientAlert" style="display: none;"></div>
                
                <form id="loginForm" action="/login" method="POST">
                    <div class="mb-4">
                        <label for="username" class="form-label fw-medium">Username or Email</label>
                        <input 
                            type="text" 
                            class="form-control form-control-lg" 
                            id="username" 
                            name="username" 
                            placeholder="Enter username or email"
                            autocomplete="username"
                        >
                    </div>
                    <div class="mb-4">
                        <label for="password" class="form-label fw-medium">Password</label>
                        <input 
                            type="password" 
                            class="form-control form-control-lg" 
                            id="password" 
                            name="password" 
                            placeholder="Enter password"
                            autocomplete="current-password"
                        >
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-airbnb-pink btn-lg fw-bold">Login</button>
                    </div>
                </form>
                
                <div class="text-center mt-4 pt-3 border-top">
                    <p class="mb-0">Not registered? <a href="/register" class="text-airbnb-pink fw-medium">Create an account</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --airbnb-pink: #FF5A5F;
        --airbnb-pink-light: #FF7E82;
        --airbnb-pink-dark: #E04E53;
        --airbnb-bg-light: #F7F7F7;
        --alert-danger-bg: rgba(255, 90, 95, 0.95);
        --alert-danger-border: rgba(255, 90, 95, 0.3);
        --alert-danger-text: #FFFFFF;
    }
    
    body {
        background-color: white;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    
    .min-vh-100 {
        min-height: 100vh;
    }
    
    .login-card {
        border-radius: 16px;
        overflow: hidden;
        margin: 0 auto;
    }
    
    .login-heading {
        color: #000000;
        font-size: 2.5rem;
        font-weight: 800;
        text-align: center;
        margin-bottom: 1.5rem;
    }
    
    .text-airbnb-pink {
        color: var(--airbnb-pink) !important;
    }
    
    .btn-airbnb-pink {
        background-color: var(--airbnb-pink);
        border-color: var(--airbnb-pink);
        color: white;
        transition: all 0.2s;
    }
    
    .btn-airbnb-pink:hover {
        background-color: var(--airbnb-pink-dark);
        border-color: var(--airbnb-pink-dark);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(255, 90, 95, 0.2);
    }
    
    .btn-airbnb-pink:active {
        transform: translateY(0);
    }
    
    .btn-airbnb-pink:disabled {
        background-color: var(--airbnb-pink-light);
        border-color: var(--airbnb-pink-light);
        opacity: 0.8;
    }
    
    .form-control {
        border-radius: 8px;
        border: 1px solid #DDDDDD;
        padding: 12px 16px;
    }
    
    .form-control:focus {
        border-color: var(--airbnb-pink-light);
        box-shadow: 0 0 0 3px rgba(255, 90, 95, 0.1);
    }
    
    .form-control-lg {
        font-size: 16px;
    }
    
    .shadow-lg {
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08) !important;
    }
    
    .border-top {
        border-color: #EEEEEE !important;
    }
    
    /* Alert Styles - Fixed for white text */
    #clientAlert {
        border-radius: 8px;
        margin-bottom: 20px;
        padding: 16px 20px;
        display: none;
        animation: slideInDown 0.3s ease;
        position: relative;
    }
    
    @keyframes slideInDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .alert-danger {
        background-color: var(--alert-danger-bg) !important;
        border: 1px solid var(--alert-danger-border) !important;
        border-left: 4px solid var(--airbnb-pink) !important;
        color: var(--alert-danger-text) !important;
        padding-right: 50px !important; /* Make space for close button */
    }
    
    /* Specific styles for alert content */
    .alert-danger .btn-close {
        filter: invert(1) brightness(100) !important;
        opacity: 0.9 !important;
        background-size: 12px !important;
        padding: 0.5rem !important;
        position: absolute !important;
        top: 50% !important;
        right: 12px !important;
        transform: translateY(-50%) !important;
        margin: 0 !important;
        width: 20px !important;
        height: 20px !important;
        background-position: center !important;
        cursor: pointer !important;
        transition: opacity 0.2s ease !important;
        border: none !important;
        background-color: transparent !important;
    }
    
    .alert-danger .btn-close:hover {
        opacity: 1 !important;
    }
    
    .alert-danger .btn-close:focus {
        box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.5) !important;
        outline: none !important;
    }
    
    .alert-danger i {
        color: white !important;
        font-size: 1.1rem !important;
        margin-right: 12px !important;
    }
    
    /* Ensure text inside alert is white */
    .alert-danger,
    .alert-danger div,
    .alert-danger span,
    .alert-danger p {
        color: white !important;
    }
    
    /* Fix flex layout for alert content */
    .alert-danger.d-flex {
        display: flex !important;
        align-items: center !important;
        flex-wrap: nowrap !important;
    }
    
    .alert-danger .flex-grow-1 {
        flex: 1 !important;
        min-width: 0 !important; /* Prevent overflow */
        margin-right: 8px !important;
    }
    
    /* Remove default Bootstrap alert padding */
    .alert {
        --bs-alert-padding-x: 1rem;
        --bs-alert-padding-y: 1rem;
        --bs-alert-margin-bottom: 1rem;
        --bs-alert-border-radius: 0.375rem;
        --bs-alert-color: inherit;
        --bs-alert-bg: transparent;
        --bs-alert-border-color: transparent;
        --bs-alert-border: 0 solid var(--bs-alert-border-color);
        --bs-alert-border-width: 1px;
        position: relative;
        padding: var(--bs-alert-padding-y) var(--bs-alert-padding-x);
        margin-bottom: var(--bs-alert-margin-bottom);
        color: var(--bs-alert-color);
        background-color: var(--bs-alert-bg);
        border: var(--bs-alert-border);
        border-radius: var(--bs-alert-border-radius);
    }
    
    /* Custom alert variables */
    .alert {
        --bs-alert-color: white;
        --bs-alert-bg: var(--alert-danger-bg);
        --bs-alert-border-color: var(--alert-danger-border);
    }
    
    @media (max-width: 768px) {
        .col-md-5 {
            padding: 0 15px;
        }
        
        .login-card {
            margin-top: 0;
        }
        
        .login-heading {
            font-size: 2rem;
        }
        
        #clientAlert {
            padding: 14px 18px;
            margin-bottom: 16px;
        }
        
        .alert-danger {
            padding-right: 45px !important;
        }
        
        .alert-danger .btn-close {
            right: 10px !important;
            width: 18px !important;
            height: 18px !important;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const loginForm = document.getElementById('loginForm');
        const usernameInput = document.getElementById('username');
        const passwordInput = document.getElementById('password');
        const clientAlert = document.getElementById('clientAlert');
        
        // Simple validation on form submit
        loginForm.addEventListener('submit', function(event) {
            const username = usernameInput.value.trim();
            const password = passwordInput.value;
            
            // Clear previous client alert
            clientAlert.style.display = 'none';
            clientAlert.innerHTML = '';
            clientAlert.className = '';
            
            let errorMessage = '';
            
            // Check if fields are empty
            if (!username && !password) {
                errorMessage = 'Both username and password are required';
            } else if (!username) {
                errorMessage = 'Username or email is required';
            } else if (!password) {
                errorMessage = 'Password is required';
            }
            
            // If there's an error, show it and prevent submission
            if (errorMessage) {
                event.preventDefault();
                
                // Show error in client alert
                clientAlert.className = 'alert alert-danger alert-dismissible fade show d-flex align-items-center';
                clientAlert.innerHTML = `
                    <i class="fas fa-exclamation-circle me-2" style="font-size: 1.1rem;"></i>
                    <div class="flex-grow-1">${errorMessage}</div>
                    <button type="button" class="btn-close" id="closeAlertBtn" aria-label="Close"></button>
                `;
                clientAlert.style.display = 'block';
                
                // Add click event to close button for HARD REFRESH
                const closeButton = document.getElementById('closeAlertBtn');
                if (closeButton) {
                    closeButton.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        
                        // HARD REFRESH the page (Ctrl+Shift+R style)
                        // Method 1: Force reload from server bypassing cache
                        window.location.href = window.location.href;
                        
                        // Method 2: More aggressive hard refresh
                        setTimeout(function() {
                            window.location.reload(true); // true forces cache bypass
                        }, 10);
                        
                        // Method 3: For modern browsers - clear cache and reload
                        if (window.location.reload) {
                            // Clear browser cache and reload
                            const timestamp = new Date().getTime();
                            const url = window.location.href.split('?')[0] + '?t=' + timestamp;
                            window.location.href = url;
                        }
                    });
                }
                
                return false;
            }
            
            // If no errors, form will submit normally
            // Show loading state
            const submitBtn = loginForm.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Logging in...';
        });
        
        // Clear client alert when user starts typing
        usernameInput.addEventListener('input', function() {
            if (clientAlert.style.display === 'block') {
                // Just hide the alert when typing starts
                // Don't hard refresh here
                clientAlert.style.opacity = '0';
                clientAlert.style.transition = 'opacity 0.3s ease';
                setTimeout(() => {
                    clientAlert.style.display = 'none';
                    clientAlert.innerHTML = '';
                    clientAlert.className = '';
                }, 300);
            }
        });
        
        passwordInput.addEventListener('input', function() {
            if (clientAlert.style.display === 'block') {
                // Just hide the alert when typing starts
                // Don't hard refresh here
                clientAlert.style.opacity = '0';
                clientAlert.style.transition = 'opacity 0.3s ease';
                setTimeout(() => {
                    clientAlert.style.display = 'none';
                    clientAlert.innerHTML = '';
                    clientAlert.className = '';
                }, 300);
            }
        });
        
        // Close alert when close button is clicked with HARD REFRESH
        clientAlert.addEventListener('click', function(e) {
            if (e.target.classList.contains('btn-close') || e.target.closest('.btn-close')) {
                e.preventDefault();
                e.stopPropagation();
                
                // HARD REFRESH the page (Ctrl+Shift+R style)
                // Clear browser cache and force reload from server
                const timestamp = new Date().getTime();
                const currentUrl = window.location.href.split('?')[0];
                const refreshUrl = currentUrl + (currentUrl.includes('?') ? '&' : '?') + '_=' + timestamp;
                
                // Force reload bypassing cache
                window.location.href = refreshUrl;
                window.location.reload(true);
            }
        });
        
        // Also handle alert clicks on dynamically created close button
        document.addEventListener('click', function(e) {
            if (e.target.id === 'closeAlertBtn' || e.target.closest('#closeAlertBtn')) {
                e.preventDefault();
                e.stopPropagation();
                
                // HARD REFRESH - multiple methods to ensure it works
                
                // Method 1: Add timestamp to URL to bypass cache
                const timestamp = new Date().getTime();
                const url = window.location.href.split('#')[0].split('?')[0];
                
                // Clear all form data
                loginForm.reset();
                
                // Force reload from server with cache bypass
                window.location.href = url + '?_=' + timestamp;
                
                // Method 2: Call reload with true parameter
                setTimeout(() => {
                    if (window.location.reload) {
                        window.location.reload(true);
                    }
                }, 50);
                
                // Method 3: For modern browsers
                if (caches && caches.keys) {
                    caches.keys().then(function(names) {
                        for (let name of names) caches.delete(name);
                    });
                }
            }
        });
    });
</script>